@model FYP.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "SPDelivery Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SecurePlatform</title>
    <link rel="stylesheet" href="~/css/auth-login.css" />
    <link rel="stylesheet" href="~/css/courier-auth.css" />
</head>
<body class="courier-bg">

    <div class="auth-container">

        <!-- Left Side: Branding -->
        <div class="branding-section">
            <div class="branding-logo-container">
                <svg class="branding-logo-icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#3B82F6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="1" y="3" width="15" height="13"></rect>
                    <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                    <circle cx="5.5" cy="18.5" r="2.5"></circle>
                    <circle cx="18.5" cy="18.5" r="2.5"></circle>
                </svg>
                <h2 class="branding-title">SP<span style="color: #3B82F6;">Delivery</span></h2>
            </div>
            <h1 class="branding-subtitle">Deliver with Speed.</h1>
            <p class="branding-description">
                Log in to view your active shipments, update delivery statuses, and ensure our customers receive their packages securely and on time.
            </p>

            <div class="branding-feature">
                <span class="branding-checkmark">✓</span> Secure Route Tracking
            </div>
            <div class="branding-feature">
                <span class="branding-checkmark">✓</span> Instant Delivery Confirmations
            </div>
        </div>

        <!-- Right Side: Login Form -->
        <div class="courier-card">
            <h3 class="form-title">Courier Portal Log In</h3>
            <p class="form-subtitle">Enter your SPDelivery credentials.</p>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="validation-summary">
                    @Html.ValidationSummary(true)
                </div>
            }

            <form asp-controller="Auth" asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Role" value="Courier" />

                <div class="form-group mb-20">
                    <label class="field-label">Email Address</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="driver@spdelivery.com" required autofocus />
                </div>

                <div class="form-group mb-20">
                    <label class="field-label">Password</label>
                    <div class="input-wrapper">
                        <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" required id="passwordInput" />
                        <button type="button" id="togglePasswordBtn" class="password-toggle-btn" aria-label="Toggle password visibility">
                            <svg id="eyeOpenIcon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                            <svg id="eyeClosedIcon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>
                        </button>
                    </div>
                </div>

                <div class="forgot-password-container">
                    <a asp-controller="Auth" asp-action="ForgotPassword" class="forgot-password-link">Forgot Password?</a>
                </div>

                <button type="submit" class="courier-primary-btn">
                    ACCESS PORTAL
                </button>
            </form>

            <div class="form-footer">
                New delivery driver? <a asp-controller="Courier" asp-action="Register" class="form-footer-link">Register here</a>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const togglePasswordBtn = document.getElementById('togglePasswordBtn');
            const passwordInput = document.getElementById('passwordInput');
            const eyeOpenIcon = document.getElementById('eyeOpenIcon');
            const eyeClosedIcon = document.getElementById('eyeClosedIcon');

            if (togglePasswordBtn && passwordInput) {
                togglePasswordBtn.addEventListener('click', function() {
                    if (passwordInput.type === 'password') {
                        passwordInput.type = 'text';
                        eyeOpenIcon.style.display = 'none';
                        eyeClosedIcon.style.display = 'block';
                    } else {
                        passwordInput.type = 'password';
                        eyeOpenIcon.style.display = 'block';
                        eyeClosedIcon.style.display = 'none';
                    }
                });
            }
        });
    </script>
</body>
</html>
