@{
    ViewData["Title"] = "Become a Merchant";
    Layout = null; // Or use your shared layout
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SecurePlatform</title>
    <link rel="stylesheet" href="~/css/auth-login.css" />
    <style>
            .onboard-bg {
                background-color: #F8F9FA;
            }

            .onboard-card {
                background: white;
                border-top: 4px solid #DD6B20;
            }
    </style>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="onboard-bg" style="display: flex; justify-content: center; align-items: center; min-height: 100vh; margin: 0; padding: 20px; font-family: 'Segoe UI', sans-serif;">

    <div style="width: 100%; max-width: 600px; box-shadow: 0 10px 25px rgba(0,0,0,0.05); border-radius: 8px; overflow: hidden;">

        <div style="background: #2D3748; padding: 30px; text-align: center; color: white;">
            <h1 style="margin: 0; font-size: 1.8rem;">Start Selling Today</h1>
            <p style="margin: 10px 0 0 0; color: #A0ABC0; font-size: 0.95rem;">
                Upgrade your account to access enterprise merchant tools, inventory tracking, and zero-trust transaction security.
            </p>
        </div>

        <div class="onboard-card" style="padding: 40px;">
            <form asp-controller="Seller" asp-action="UpgradeAccount" method="post">
                @Html.AntiForgeryToken()

                <div class="form-group" style="margin-bottom: 20px;">
                    <label style="font-size: 0.85rem; font-weight: 600; color: #4A5568; margin-bottom: 6px; display: block;">Store Name</label>
                    <input type="text" name="storeName" placeholder="e.g., TechHub Enterprise" required autofocus
                           style="width: 100%; padding: 12px; border: 1px solid #CBD5E0; border-radius: 4px; font-size: 1rem; box-sizing: border-box;" />
                </div>

                <div class="form-group" style="margin-bottom: 30px;">
                    <label style="font-size: 0.85rem; font-weight: 600; color: #4A5568; margin-bottom: 6px; display: block;">SSM Registration Number (Optional)</label>
                    <input type="text" name="ssmNumber" placeholder="e.g., 202301123456"
                           style="width: 100%; padding: 12px; border: 1px solid #CBD5E0; border-radius: 4px; font-size: 1rem; box-sizing: border-box;" />
                    <span style="font-size: 0.75rem; color: #718096; display: block; margin-top: 6px;">Providing a valid Suruhanjaya Syarikat Malaysia (SSM) number boosts your store's trust rating.</span>
                </div>

                <div style="background: #FFF5F5; padding: 15px; border-left: 4px solid #F56565; margin-bottom: 25px; font-size: 0.85rem; color: #C53030;">
                    <strong>Security Notice:</strong> By upgrading, your merchant wallet will be bound to your existing Multi-Factor Authentication (MFA) credentials.
                </div>

                <button type="submit" style="width: 100%; padding: 14px; font-size: 1rem; background: #DD6B20; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold;">
                    ACTIVATE MERCHANT ACCOUNT
                </button>
            </form>

            <div style="text-align: center; margin-top: 20px;">
                <a href="javascript:history.back()" style="color: #718096; font-size: 0.85rem; text-decoration: none;">Cancel and return to profile</a>
            </div>
        </div>
    </div>

    @await Html.PartialAsync("_ChatPartial")
</body>
</html>