@model FYP.Models.ViewModels.ChangePasswordOtpViewModel
@inject FYP.Data.ApplicationDbContext Context
@{
    ViewData["Title"] = "Verify OTP - Seller Centre";
    Layout = null;

    var currentUserId = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var currentUser = Context.Users.FirstOrDefault(u => u.UserID == currentUserId);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SecurePlatform</title>
    <link rel="stylesheet" href="~/css/auth-login.css" />
    <link rel="stylesheet" href="~/css/seller-dashboard.css" />
    <link rel="stylesheet" href="~/css/user-profile.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body style="background-color: #F8F9FA;">

    <!-- Top Navigation Bar -->
    <header class="auth-navbar">
        <div class="nav-container">
            <div style="display: flex; align-items: center;">
                <a asp-controller="Seller" asp-action="Dashboard" class="brand-group">
                    <svg viewBox="0 0 24 24">
                        <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z" />
                    </svg>
                    <span class="brand-text">SecurePlatform</span>
                </a>
                <span class="page-label">Seller Centre</span>
            </div>
            <div>
                <a asp-controller="Home" asp-action="Index" class="help-link" style="margin-right: 20px;">View Storefront</a>
                <a asp-controller="Auth" asp-action="Logout" asp-route-returnUrl="/Seller/Login" style="color: var(--text-dark); text-decoration: none; font-weight: 600; font-size: 0.9rem;">Log Out</a>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="dashboard-container">

<div class="profile-container" style="margin-top: 20px; box-shadow: none;">
    <div class="profile-sidebar">
        <div class="user-brief">
            <div class="avatar-circle" style="background: transparent; overflow: hidden; border: 1px solid #e0e0e0; display: flex; align-items: center; justify-content: center; position: relative;">
                <img src="/uploads/profiles/@(currentUser?.UserID).jpg?v=@(DateTime.Now.Ticks)" 
                     style="width: 100%; height: 100%; object-fit: cover; display: block;" 
                     onerror="this.style.display='none'; document.getElementById('sidebar-default-avatar').style.display='block';" />
                <svg id="sidebar-default-avatar" style="display: none; width: 24px; height: 24px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                </svg>
            </div>
            <div class="user-brief-info">
                <div class="username-text">@(string.IsNullOrEmpty(currentUser?.Name) ? User.Identity?.Name : currentUser.Name)</div>
                <a href="/Seller/Profile" class="edit-profile-link">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 20h9"></path>
                        <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                    </svg> Edit Profile
                </a>
            </div>
        </div>
        <nav class="profile-nav">
            <div class="nav-group active">
                <div class="nav-group-header">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                    <span>My Account</span>
                </div>
                <ul class="nav-list">
                    <li><a href="/Seller/Profile">Profile</a></li>
                    <li><a href="/Seller/ChangePasswordVerify" class="active">Change Password</a></li>
                    <li><a href="/Seller/TrustedDevices">Trusted Devices</a></li>
                </ul>
            </div>
        </nav>
    </div>

    <div class="profile-content">
        <div class="content-header">
            <h2>Enter Verification Code</h2>
            <p>We've sent a 6-digit code to your registered email address.</p>
        </div>
        <div class="content-body">
            <div class="profile-form-section" style="max-width: 700px; padding-top: 20px;">
                <form asp-action="ChangePasswordOtp" method="post">
                    @Html.AntiForgeryToken()
                    
                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ContainsKey(string.Empty) && ViewData.ModelState[string.Empty].Errors.Count > 0)
                    {
                        <div class="form-row">
                            <label></label>
                            <div class="form-field">
                                <div id="loginErrorMsg" style="color: #ee4d2d; font-size: 13px; text-align: left; background: #fff8f8; border: 1px solid #ffd2d2; padding: 10px; width: 100%; border-radius: 2px;">
                                    @foreach (var error in ViewData.ModelState[string.Empty].Errors)
                                    {
                                        <div>@error.ErrorMessage</div>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    <div class="form-row">
                        <label asp-for="OtpCode">Verification Code</label>
                        <div class="form-field" style="flex-direction: column; align-items: flex-start; gap: 5px;">
                            <div style="display: flex; gap: 10px; width: 100%;">
                                <input asp-for="OtpCode" type="text" class="form-control" placeholder="Enter 6-digit OTP code" autofocus style="flex-grow: 1;" />
                                <button type="button" id="btnResendOtp" class="btn-submit-primary" style="width: 140px; background-color: #fff; color: #EE4D2D; border: 1px solid #EE4D2D; padding: 10px; cursor: pointer; font-size: 0.85rem;">Resend Code</button>
                            </div>
                            <span asp-validation-for="OtpCode" class="text-danger" style="font-size: 0.8rem;"></span>
                        </div>
                    </div>
                    

                    <div class="form-row">
                        <label></label>
                        <div class="form-field">
                            <button type="submit" class="btn-submit-primary" style="width: auto; background-color: #EE4D2D; color: #FFFFFF; border: none; border-radius: 2px; padding: 10px 25px; font-weight: 500; cursor: pointer; transition: background 0.2s;">Verify Code</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
<script>
    $(document).ready(function() {
        $('.form-control').on('input', function() {
            $('#loginErrorMsg').hide();
        });

        var $btnResend = $('#btnResendOtp');
        var timer = 60;
        var interval;

        function startTimer() {
            timer = 60;
            $btnResend.prop('disabled', true);
            $btnResend.css({ 'background-color': '#f5f5f5', 'color': '#888', 'cursor': 'not-allowed', 'border-color': '#ddd' });
            
            interval = setInterval(function() {
                timer--;
                $btnResend.text('Resend (' + timer + 's)');
                
                if (timer <= 0) {
                    clearInterval(interval);
                    $btnResend.prop('disabled', false);
                    $btnResend.text('Resend Code');
                    $btnResend.css({ 'background-color': '#fff', 'color': '#EE4D2D', 'cursor': 'pointer', 'border-color': '#EE4D2D' });
                }
            }, 1000);
        }

        startTimer();

        $btnResend.click(function() {
            if ($(this).prop('disabled')) return;
            
            var token = $('input[name="__RequestVerificationToken"]').val();
            $btnResend.prop('disabled', true).text('Sending...');

            $.ajax({
                url: '/Seller/ResendChangePasswordOtp',
                type: 'POST',
                data: { __RequestVerificationToken: token },
                success: function(response) {
                    if(response.success) {
                        alert("A new 6-digit security code has been dispatched to your email address.");
                        startTimer();
                    } else {
                        alert(response.message || "Failed to resend code. Please try again.");
                        $btnResend.prop('disabled', false).text('Resend Code');
                    }
                },
                error: function() {
                    alert("An error occurred while resending the code.");
                    $btnResend.prop('disabled', false).text('Resend Code');
                }
            });
        });
    });
</script>
</main>

    @await Html.PartialAsync("_ChatPartial")
</body>
</html>
