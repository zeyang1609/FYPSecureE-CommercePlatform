@model IEnumerable<FYP.Models.Entities.Notification>
@{
    ViewData["Title"] = "My Notifications";
    Layout = "~/Views/Shared/_SellerLayout.cshtml";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="fas fa-bell text-warning me-2"></i> Notifications</h2>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert" style="border-radius: 8px;">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0" style="border-radius: 12px; overflow: hidden;">
        @if (Model != null && Model.Any())
        {
            <div class="list-group list-group-flush">
                @foreach (var notification in Model)
                {
                    var iconClass = "fa-info-circle text-primary";
                    var bgColor = "#f8f9fa";
                    
                    if (notification.Type.Contains("Order")) { iconClass = "fa-box text-success"; }
                    else if (notification.Type.Contains("Refund")) { iconClass = "fa-undo-alt text-danger"; }
                    else if (notification.Type.Contains("Inventory") || notification.Type.Contains("Stock")) { iconClass = "fa-exclamation-triangle text-warning"; }
                    else if (notification.Type.Contains("System") || notification.Type.Contains("Announcement")) { iconClass = "fa-bullhorn text-info"; bgColor = "#e0f7fa"; }
                    
                    <div class="list-group-item list-group-item-action d-flex align-items-center p-4" style="background-color: @bgColor; border-bottom: 1px solid #e9ecef;">
                        <div class="me-4" style="font-size: 2rem;">
                            <i class="fas @iconClass"></i>
                        </div>
                        <div class="flex-grow-1">
                            <h6 class="mb-1 fw-bold">@notification.Type</h6>
                            <p class="mb-0 text-muted" style="font-size: 0.95rem;">@notification.Content</p>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="card-body text-center py-5">
                <i class="fas fa-bell-slash fa-4x text-muted mb-3" style="opacity: 0.5;"></i>
                <h5 class="text-muted">No notifications yet.</h5>
                <p class="text-muted">When you get orders, refund requests, or low stock alerts, they will appear here.</p>
            </div>
        }
    </div>
</div>
