@model FYP.Models.ViewModels.SellerProfileViewModel
@{
    ViewData["Title"] = "My Profile - Seller Centre";
    Layout = null;
    var userEmail = Model.Email ?? "";
    var emailParts = userEmail.Split('@');
    var maskedEmail = emailParts.Length == 2 && emailParts[0].Length > 2 
        ? emailParts[0].Substring(0, 2) + new string('x', emailParts[0].Length - 2) + "@" + emailParts[1] 
        : userEmail;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SecurePlatform</title>
    <link rel="stylesheet" href="~/css/auth-login.css" />
    <link rel="stylesheet" href="~/css/seller-dashboard.css" />
    <link rel="stylesheet" href="~/css/user-profile.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" rel="stylesheet" />
</head>
<body style="background-color: #F8F9FA;">

    <!-- Top Navigation Bar -->
    <header class="auth-navbar">
        <div class="nav-container">
            <div style="display: flex; align-items: center;">
                <a asp-controller="Seller" asp-action="Dashboard" class="brand-group">
                    <svg viewBox="0 0 24 24">
                        <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z" />
                    </svg>
                    <span class="brand-text">SecurePlatform</span>
                </a>
                <span class="page-label">Seller Centre</span>
            </div>
            <div>
                <a asp-controller="Home" asp-action="Index" class="help-link" style="margin-right: 20px;">View Storefront</a>
                <a asp-controller="Auth" asp-action="Logout" asp-route-returnUrl="/Seller/Login" style="color: var(--text-dark); text-decoration: none; font-weight: 600; font-size: 0.9rem;">Log Out</a>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="dashboard-container">

<div class="profile-container" style="margin-top: 20px; box-shadow: none;">
    <div class="profile-sidebar">
        <div class="user-brief">
            <div class="avatar-circle" style="background: transparent; overflow: hidden; border: 1px solid #e0e0e0; display: flex; align-items: center; justify-content: center; position: relative;">
                <img src="/uploads/profiles/@(Model.UserID).jpg?v=@(DateTime.Now.Ticks)" 
                     style="width: 100%; height: 100%; object-fit: cover; display: block;" 
                     onerror="this.style.display='none'; document.getElementById('sidebar-default-avatar').style.display='block';" />
                <svg id="sidebar-default-avatar" style="display: none; width: 24px; height: 24px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                </svg>
            </div>
            <div class="user-brief-info">
                <div class="username-text">@(string.IsNullOrEmpty(Model.Name) ? Model.Email.Split('@')[0] : Model.Name)</div>
                <a href="#" class="edit-profile-link">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 20h9"></path>
                        <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                    </svg> Edit Profile
                </a>
            </div>
        </div>
        <nav class="profile-nav">
            <div class="nav-group active">
                <div class="nav-group-header">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                    <span>My Account</span>
                </div>
                <ul class="nav-list">
                    <li><a href="/Seller/Profile" class="active">Profile</a></li>
                    <li><a href="/Seller/ChangePasswordVerify">Change Password</a></li>
                    <li><a href="/Seller/TrustedDevices">Trusted Devices</a></li>
                </ul>
            </div>
        </nav>
        </nav>
    </div>

    <div class="profile-content">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert" style="margin: 0 30px 20px 30px; background-color: #d4edda; color: #155724; padding: 15px; border-radius: 4px; border: 1px solid #c3e6cb;">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger" style="margin: 0 30px 20px 30px; padding: 15px; border-radius: 4px;">@TempData["ErrorMessage"]</div>
        }

        <div id="profile-view-block" style="display: @(ViewBag.EmailChangeStep == null && ViewBag.PhoneChangeStep == null ? "block" : "none");">
            <div class="content-header">
                <h2>My Profile</h2>
                <p>Manage and protect your account</p>
            </div>
            <div class="content-body">
                <div class="profile-form-section">
                <form asp-action="UpdateProfile" method="post">
                    <input type="hidden" asp-for="UserID" />
                    
                    <div class="form-row">
                        <label>Username</label>
                        <div class="form-field">
                            <span class="static-text" style="color: #333; font-weight: 500;">@Model.Email.Split('@')[0]</span>
                        </div>
                    </div>
                    <div class="form-row">
                        <label asp-for="Name"></label>
                        <div class="form-field">
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-row">
                        <label>Email</label>
                        <div class="form-field">
                            <input type="hidden" asp-for="Email" />
                            <span class="static-text" style="color: #333;">@maskedEmail</span>
                            <button type="button" onclick="document.getElementById('start-email-change-form').submit();" class="btn btn-link p-0 ms-3 text-decoration-underline" style="color: #0055AA; font-size: 13px; border: none; cursor: pointer;">Change</button>
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-row">
                        <label>Phone Number</label>
                        <div class="form-field">
                            <input type="hidden" asp-for="PhoneNumber" />
                            @{
                                var phone = Model.PhoneNumber ?? "";
                                var maskedPhone = phone.Length > 2 
                                    ? new string('x', phone.Length - 2) + phone.Substring(phone.Length - 2) 
                                    : phone;
                            }
                            <span class="static-text" style="color: #333;">@(string.IsNullOrEmpty(maskedPhone) ? "Not set" : maskedPhone)</span>
                            <button type="button" onclick="showPhoneChange()" class="btn btn-link p-0 ms-3 text-decoration-underline" style="color: #0055AA; font-size: 13px; border: none; cursor: pointer;">Change</button>
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-row">
                        <label asp-for="StoreName"></label>
                        <div class="form-field">
                            <input asp-for="StoreName" class="form-control" />
                            <span asp-validation-for="StoreName" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-row">
                        <label asp-for="SSMNumber"></label>
                        <div class="form-field">
                            <input asp-for="SSMNumber" class="form-control" readonly style="background-color: #f5f5f5; cursor: not-allowed;" />
                            <div style="font-size: 12px; color: #888; margin-top: 5px;">SSM registration number cannot be changed.</div>
                        </div>
                    </div>
                    <div class="form-row" style="align-items: flex-start;">
                        <label style="line-height: 1.4;">Enable<br/>Multi-Factor<br/>Authentication<br/>(MFA)</label>
                        <div class="form-field checkbox-group" style="padding-top: 10px;">
                            <input asp-for="MfaEnabled" type="checkbox" />
                            <span style="margin-left: 8px;">Enable Two-Factor Authentication</span>
                        </div>
                    </div>

                    <div class="form-row" style="margin-top: 30px;">
                        <label></label>
                        <div class="form-field">
                            <button type="submit" class="btn-save">Save</button>
                        </div>
                    </div>
                </form>
                <form id="start-email-change-form" asp-action="StartEmailChange" method="post" style="display: none;"></form>
            </div>
            <div class="profile-avatar-section">
                <div style="position: relative; width: 100px; height: 100px; margin: 0 auto 15px; cursor: pointer;" onclick="viewFullImage()">
                    <!-- The actual profile picture -->
                    <img id="profile-img-preview" src="/uploads/profiles/@(Model.UserID).jpg?v=@(DateTime.Now.Ticks)" 
                         style="width: 100px; height: 100px; border-radius: 50%; object-fit: cover; border: 1px solid #e0e0e0; display: block;" 
                         onerror="this.style.display='none'; document.getElementById('default-avatar-@Model.UserID').style.display='flex';" />
                    
                    <!-- Fallback default avatar -->
                    <div id="default-avatar-@Model.UserID" class="shadow" style="width: 100px; height: 100px; background-color: #f0f0f0; color: #EE4D2D; border-radius: 50%; border: 1px solid #e0e0e0; font-size: 36px; font-weight: bold; display: none; align-items: center; justify-content: center;">
                        @(string.IsNullOrEmpty(Model.Name) ? Model.Email.Substring(0, 1).ToUpper() : Model.Name.Substring(0, 1).ToUpper())
                    </div>
                </div>

                <form asp-action="UploadProfilePicture" method="post" enctype="multipart/form-data" id="profilePicForm">
                    <input type="file" id="profilePictureInput" name="profilePicture" accept="image/png, image/jpeg" style="display: none;" onchange="handleImageSelect(event);" />
                    <button type="button" class="btn-select-image" onclick="document.getElementById('profilePictureInput').click();">Select Image</button>
                </form>
                
                <div class="avatar-hints mt-2">
                    File size: maximum 1 MB<br/>
                    File extension: .JPEG, .PNG
                </div>
            </div>
        </div>
        </div>

        <div id="change-phone" style="display: @(ViewBag.PhoneChangeStep != null ? "block" : "none");">
            <div class="content-header" style="display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <h2>Change Phone Number</h2>
                    <p>Enter your new Malaysian phone number</p>
                </div>
                <a href="/Seller/Profile" class="btn btn-outline-secondary" style="font-size: 13px; border-radius: 2px; padding: 6px 12px; background: white; border: 1px solid #ccc; cursor: pointer; text-decoration: none; color: #333;">&larr; Back to Profile</a>
            </div>
            <div class="content-body" style="padding-top: 10px;">
                <form asp-action="ChangePhoneNumber" method="post" style="width: 100%;">
                    <div class="form-row">
                        <label>New Phone Number</label>
                        <div class="form-field">
                            <input type="tel" id="newPhoneNumberInput" name="newPhoneNumber" class="form-control" placeholder="+601x-xxxxxxx" required maxlength="13" style="max-width: 250px;" />
                            <div style="font-size: 12px; color: #999; margin-top: 5px;">Format: 01x-xxxxxxx or +601x-xxxxxxx</div>
                        </div>
                    </div>
                    @if (ViewBag.PhoneChangeError != null)
                    {
                        <div class="form-row" style="margin-top: 0;">
                            <label></label>
                            <div class="form-field">
                                <div style="color: #dc3545; font-size: 13px; padding: 8px 12px; background: #fff5f5; border: 1px solid #f5c6cb; border-radius: 4px;">@ViewBag.PhoneChangeError</div>
                            </div>
                        </div>
                    }
                    <div class="form-row" style="margin-top: 30px;">
                        <label></label>
                        <div class="form-field">
                            <button type="submit" class="btn-save" style="padding: 10px 40px; background-color: #ee4d2d; color: #fff; border: none; border-radius: 2px; cursor: pointer;">Save</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        @if (ViewBag.EmailChangeStep as int? == 1)
        {
        <div id="change-email-step1" style="display: block;">
            <div class="content-header" style="display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <h2>Security Verification (Step 1/2)</h2>
                    <p>Enter the 6-digit verification code sent to your current email: <strong>@maskedEmail</strong></p>
                </div>
                <a href="/Seller/Profile" class="btn btn-outline-secondary" style="font-size: 13px; border-radius: 2px; padding: 6px 12px; background: white; border: 1px solid #ccc; cursor: pointer; text-decoration: none; color: #333;">&larr; Cancel</a>
            </div>
            <div class="content-body" style="padding-top: 10px;">
                <form id="current-email-verify-form" asp-action="VerifyCurrentEmailOtp" method="post" style="width: 100%;">
                    <div class="form-row">
                        <label>Verification Code</label>
                        <div class="form-field">
                            <input type="text" name="otpCode" class="form-control" placeholder="123456" required maxlength="6" style="max-width: 150px; letter-spacing: 4px; font-weight: bold; text-align: center;" />
                        </div>
                    </div>
                    <div class="form-row" style="margin-top: 5px;">
                        <label></label>
                        <div class="form-field">
                            <div id="resend-container-step1" style="margin-top: 4px;">
                                <button type="button" id="btnResendCurrentOtp" class="btn-submit-primary" style="width: 140px; background-color: #fff; color: #EE4D2D; border: 1px solid #EE4D2D; padding: 10px; cursor: pointer; font-size: 0.85rem;">Resend Code</button>
                            </div>
                        </div>
                    </div>
                    <div class="form-row" style="margin-top: 30px;">
                        <label></label>
                        <div class="form-field">
                            <button type="submit" class="btn-save" style="padding: 10px 40px; background-color: #ee4d2d; color: #fff; border: none; border-radius: 2px; cursor: pointer;">Next &rarr;</button>
                        </div>
                    </div>
                </form>
                <form id="resend-current-form" asp-action="ResendCurrentEmailOtp" method="post" style="display: none;"></form>
            </div>
        </div>
        }

        @if (ViewBag.EmailChangeStep as int? == 2)
        {
        <div id="change-email-step2" style="display: block;">
            <div class="content-header" style="display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <h2>Enter New Email (Step 2/2)</h2>
                    <p>Enter the new email address you want to link to your account.</p>
                </div>
                <a href="/Seller/Profile" class="btn btn-outline-secondary" style="font-size: 13px; border-radius: 2px; padding: 6px 12px; background: white; border: 1px solid #ccc; cursor: pointer; text-decoration: none; color: #333;">&larr; Cancel</a>
            </div>
            <div class="content-body" style="padding-top: 10px;">
                <form id="email-change-form" asp-action="InitiateEmailChange" method="post" style="width: 100%;">
                    <div class="form-row">
                        <label>Current Email</label>
                        <div class="form-field">
                            <span class="static-text" style="color: #333; font-weight: 500;">@maskedEmail</span>
                        </div>
                    </div>
                    <div class="form-row">
                        <label>New Email:</label>
                        <div class="form-field">
                            <input type="email" name="newEmail" class="form-control" placeholder="Enter new email address" required style="max-width: 300px;" />
                        </div>
                    </div>
                    <div class="form-row" style="margin-top: 40px;">
                        <label></label>
                        <div class="form-field">
                            <button type="submit" class="btn-save" style="padding: 10px 40px; background-color: #ee4d2d; color: #fff; border: none; border-radius: 2px; cursor: pointer;">Send OTP &rarr;</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
        }

        @if (ViewBag.EmailChangeStep as int? == 3)
        {
        <div id="change-email-step3" style="display: block;">
            <div class="content-header" style="display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <h2>Verify New Email</h2>
                    <p>Enter the 6-digit code sent to <strong>@ViewBag.PendingNewEmail</strong></p>
                </div>
                <a href="/Seller/Profile" class="btn btn-outline-secondary" style="font-size: 13px; border-radius: 2px; padding: 6px 12px; background: white; border: 1px solid #ccc; cursor: pointer; text-decoration: none; color: #333;">&larr; Cancel</a>
            </div>
            <div class="content-body" style="padding-top: 10px;">
                <form id="email-verify-form" asp-action="VerifyEmailChange" method="post" style="width: 100%;">
                    <input type="hidden" name="pendingEmail" value="@ViewBag.PendingNewEmail" />
                    <div class="form-row">
                        <label>Verification Code</label>
                        <div class="form-field">
                            <input type="text" name="otpCode" class="form-control" placeholder="123456" required maxlength="6" style="max-width: 150px; letter-spacing: 4px; font-weight: bold; text-align: center;" />
                        </div>
                    </div>
                    <div class="form-row" style="margin-top: 5px;">
                        <label></label>
                        <div class="form-field">
                            <div id="resend-container-step3" style="margin-top: 4px;">
                                <button type="button" id="btnResendNewOtp" class="btn-submit-primary" style="width: 140px; background-color: #fff; color: #EE4D2D; border: 1px solid #EE4D2D; padding: 10px; cursor: pointer; font-size: 0.85rem;">Resend Code</button>
                            </div>
                        </div>
                    </div>
                    <div class="form-row" style="margin-top: 30px;">
                        <label></label>
                        <div class="form-field">
                            <button type="submit" class="btn-save" style="padding: 10px 40px; background-color: #ee4d2d; color: #fff; border: none; border-radius: 2px; cursor: pointer;">Verify & Save</button>
                        </div>
                    </div>
                </form>
                <form id="resend-new-form" asp-action="InitiateEmailChange" method="post" style="display: none;">
                    <input type="hidden" name="newEmail" value="@ViewBag.PendingNewEmail" />
                </form>
            </div>
        </div>
        }

    </div>
</div>
</main>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
<script>
        function showProfileView() {
            document.getElementById('change-phone').style.display = 'none';
            document.getElementById('profile-view-block').style.display = 'block';
        }
        function showPhoneChange() {
            document.getElementById('profile-view-block').style.display = 'none';
            document.getElementById('change-phone').style.display = 'block';
        }

        function setupOtpTimer(btnId, formId, storageKey) {
            const btn = document.getElementById(btnId);
            const form = document.getElementById(formId);
            if (!btn || !form) return;

            @if (TempData["ResetOtpTimer"] != null)
            {
                <text>
                localStorage.removeItem(storageKey);
                </text>
            }

            function startTimer() {
                let now = Math.floor(Date.now() / 1000);
                let sentTime = localStorage.getItem(storageKey);
                if (!sentTime) {
                    sentTime = now;
                    localStorage.setItem(storageKey, sentTime);
                }
                let elapsed = now - parseInt(sentTime);
                let timer = 60 - elapsed;

                if (timer <= 0) {
                    btn.disabled = false;
                    btn.textContent = 'Resend Code';
                    btn.style.backgroundColor = '#fff';
                    btn.style.color = '#EE4D2D';
                    btn.style.cursor = 'pointer';
                    btn.style.borderColor = '#EE4D2D';
                    return;
                }

                btn.disabled = true;
                btn.style.backgroundColor = '#f5f5f5';
                btn.style.color = '#888';
                btn.style.cursor = 'not-allowed';
                btn.style.borderColor = '#ddd';
                btn.textContent = 'Resend (' + timer + 's)';

                let interval = setInterval(function() {
                    timer--;
                    if (timer <= 0) {
                        clearInterval(interval);
                        btn.disabled = false;
                        btn.textContent = 'Resend Code';
                        btn.style.backgroundColor = '#fff';
                        btn.style.color = '#EE4D2D';
                        btn.style.cursor = 'pointer';
                        btn.style.borderColor = '#EE4D2D';
                    } else {
                        btn.textContent = 'Resend (' + timer + 's)';
                    }
                }, 1000);
            }

            startTimer();

            btn.addEventListener('click', function(e) {
                e.preventDefault();
                if (this.disabled) return;
                localStorage.setItem(storageKey, Math.floor(Date.now() / 1000));
                form.submit();
            });
        }

        setupOtpTimer('btnResendCurrentOtp', 'resend-current-form', 'otpResendCurrent_' + '@(Model.Email)');
        setupOtpTimer('btnResendNewOtp', 'resend-new-form', 'otpResendNew_' + '@(ViewBag.PendingNewEmail ?? "")');

        const phoneInput = document.getElementById('newPhoneNumberInput');
        if (phoneInput) {
            phoneInput.addEventListener('focus', function() {
                if (!this.value) {
                    this.value = '+601';
                }
            });
            phoneInput.addEventListener('input', function() {
                if (!this.value.startsWith('+601')) {
                    if (this.value.startsWith('01')) {
                        this.value = '+60' + this.value.substring(1);
                    } else if (this.value.startsWith('601')) {
                        this.value = '+' + this.value;
                    } else {
                        this.value = '+601';
                    }
                }
                const prefix = '+601';
                const rest = this.value.substring(prefix.length).replace(/[^\d]/g, '');
                this.value = prefix + rest;
            });
            phoneInput.addEventListener('blur', function() {
                if (this.value === '+601') {
                    this.value = '';
                }
            });
        }
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
    <script>
        let cropper = null;
        let originalFile = null;

        function handleImageSelect(event) {
            const file = event.target.files[0];
            if (!file) return;

            originalFile = file;

            const reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('cropperImage').src = e.target.result;
                document.getElementById('cropperModal').style.display = 'flex';
                
                if (cropper) {
                    cropper.destroy();
                }
                
                cropper = new Cropper(document.getElementById('cropperImage'), {
                    aspectRatio: 1,
                    viewMode: 1,
                    autoCropArea: 1,
                });
            };
            reader.readAsDataURL(file);
            
            // Clear input so same file can be selected again
            event.target.value = '';
        }

        function closeCropperModal() {
            document.getElementById('cropperModal').style.display = 'none';
            if (cropper) {
                cropper.destroy();
                cropper = null;
            }
        }

        async function cropAndUpload() {
            if (!cropper) return;
            
            const btn = document.getElementById('btnCropSave');
            btn.disabled = true;
            btn.innerText = 'Uploading...';

            cropper.getCroppedCanvas({
                width: 400,
                height: 400
            }).toBlob(async (blob) => {
                const formData = new FormData();
                formData.append('profilePicture', blob, 'cropped.jpg');
                if (originalFile) {
                    formData.append('originalPicture', originalFile, originalFile.name);
                }
                
                const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                if (csrfToken) {
                    formData.append('__RequestVerificationToken', csrfToken);
                }

                try {
                    const response = await fetch('/Seller/UploadProfilePicture', {
                        method: 'POST',
                        body: formData
                    });
                    if (response.ok) {
                        window.location.reload();
                    } else {
                        alert('Upload failed');
                        btn.disabled = false;
                        btn.innerText = 'Crop & Save';
                    }
                } catch (err) {
                    console.error(err);
                    alert('Error uploading image');
                    btn.disabled = false;
                    btn.innerText = 'Crop & Save';
                }
            }, 'image/jpeg');
        }

        function viewFullImage() {
            document.getElementById('fullImageModal').style.display = 'flex';
        }
        function closeFullImageModal() {
            document.getElementById('fullImageModal').style.display = 'none';
        }
    </script>

    <!-- Cropper Modal -->
    <div id="cropperModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); z-index: 1050; align-items: center; justify-content: center; flex-direction: column;">
        <div style="background: white; padding: 20px; border-radius: 8px; width: 90%; max-width: 500px;">
            <h3 style="margin-top: 0; margin-bottom: 15px;">Crop Profile Picture</h3>
            <div style="max-height: 400px; overflow: hidden; margin-bottom: 20px;">
                <img id="cropperImage" style="max-width: 100%; display: block;" />
            </div>
            <div style="display: flex; justify-content: flex-end; gap: 10px;">
                <button type="button" class="btn btn-outline-secondary" onclick="closeCropperModal()" style="padding: 8px 16px; border: 1px solid #ccc; background: white; cursor: pointer;">Cancel</button>
                <button type="button" id="btnCropSave" onclick="cropAndUpload()" style="padding: 8px 16px; background: #EE4D2D; color: white; border: none; cursor: pointer;">Crop & Save</button>
            </div>
        </div>
    </div>

    <!-- Full Image Viewer Modal -->
    <div id="fullImageModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.9); z-index: 1100; align-items: center; justify-content: center;" onclick="closeFullImageModal()">
        <span style="position: absolute; top: 20px; right: 30px; color: white; font-size: 40px; cursor: pointer;">&times;</span>
        <img src="/uploads/profiles/@(Model.UserID)_full.jpg" style="max-width: 90%; max-height: 90%; object-fit: contain;" onerror="this.onerror=null; this.src='/uploads/profiles/@(Model.UserID).jpg';" />
    </div>

    @await Html.PartialAsync("_ChatPartial")
</body>
</html>
