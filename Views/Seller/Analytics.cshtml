@model IEnumerable<FYP.Models.Entities.Product>
@{
    ViewData["Title"] = "Analytics & Reports - Seller Centre";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SecurePlatform</title>
    <link rel="stylesheet" href="~/css/auth-login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/seller-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
    :root {
        --brand-primary: #EE4D2D;
        --brand-secondary: #FF6633;
        --bg-gray: #f5f5f5;
        --border-color: #e5e5e5;
        --text-dark: #222;
        --text-muted: #757575;
    }

    body {
        background-color: var(--bg-gray);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    .dashboard-container {
        max-width: 1200px;
        margin: 20px auto;
        padding: 0 15px;
    }

    .page-header {
        background: white;
        padding: 20px 24px;
        border-radius: 4px;
        box-shadow: 0 1px 2px rgba(0,0,0,0.05);
        margin-bottom: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .chart-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 24px;
    }

    .card {
        background: white;
        border-radius: 4px;
        box-shadow: 0 1px 2px rgba(0,0,0,0.05);
        padding: 20px;
    }

    .card h3 {
        margin-top: 0;
        margin-bottom: 20px;
        font-size: 1.1rem;
        color: var(--text-dark);
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 10px;
    }

    .table-responsive {
        overflow-x: auto;
    }

    .stock-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.95rem;
    }

    .stock-table th {
        background-color: #fafafa;
        padding: 12px 15px;
        text-align: left;
        color: var(--text-muted);
        font-weight: 600;
        border-bottom: 1px solid var(--border-color);
    }

    .stock-table td {
        padding: 15px;
        border-bottom: 1px solid var(--border-color);
        vertical-align: middle;
    }

    .stock-table tbody tr:hover {
        background-color: #fafafa;
    }
</style>
</head>
<body style="background-color: #F8F9FA;">

    <!-- Top Navigation Bar -->
    <header class="auth-navbar">
        <div class="nav-container">
            <div style="display: flex; align-items: center;">
                <a asp-controller="Seller" asp-action="Dashboard" class="brand-group">
                    <svg viewBox="0 0 24 24">
                        <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z" />
                    </svg>
                    <span class="brand-text">SecurePlatform</span>
                </a>
                <span class="page-label">Seller Centre</span>
            </div>
            <div>
                <a asp-controller="Home" asp-action="Index" class="help-link" style="margin-right: 20px;">View Storefront</a>
                <a asp-controller="Auth" asp-action="Logout" asp-route-returnUrl="/Seller/Login" style="color: var(--text-dark); text-decoration: none; font-weight: 600; font-size: 0.9rem;">Log Out</a>
            </div>
        </div>
    </header>

<main class="dashboard-container">
    <div class="page-header">
        <div>
            <h1 style="margin: 0; font-size: 1.5rem; color: var(--text-dark);">Reporting & Analytics Module</h1>
            <p style="margin: 5px 0 0 0; color: var(--text-muted); font-size: 0.9rem;">
                Sales analytics and stock demand reports for Seller ID: <strong>@ViewBag.SellerID</strong>
            </p>
        </div>
        <div>
            <a asp-controller="Seller" asp-action="Dashboard" class="btn btn-outline-secondary" style="background: white; border: 1px solid #ccc; padding: 8px 16px; border-radius: 4px; text-decoration: none; color: #333; font-weight: 600;">
                &larr; Back to Dashboard
            </a>
        </div>
    </div>

    <div class="chart-grid">
        <!-- Sales Analytics: Revenue Over Time -->
        <div class="card">
            <h3>Revenue Over Time (Last 30 Days)</h3>
            <div style="position: relative; height: 300px; width: 100%;">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>

        <!-- Sales Analytics: Sales by Product -->
        <div class="card">
            <h3>Top Selling Products</h3>
            <div style="position: relative; height: 300px; width: 100%;">
                <canvas id="productChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Stock & Demand Reports -->
    <div class="card">
        <h3>Stock & Demand Reports (Inventory Performance)</h3>
        <div class="table-responsive">
            <table class="stock-table">
                <thead>
                    <tr>
                        <th>Product ID</th>
                        <th>Product Title</th>
                        <th>Category</th>
                        <th>Current Stock</th>
                        <th>Total Lifetime Sales</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td style="color: var(--text-muted);">@item.ProductID</td>
                            <td style="font-weight: 500;">@item.Title</td>
                            <td>@(item.Category != null ? item.Category.Name : "N/A")</td>
                            <td>
                                @if (item.StockLevel <= 5)
                                {
                                    <span style="color: #ef4444; font-weight: bold;">@item.StockLevel units (Low)</span>
                                }
                                else
                                {
                                    <span>@item.StockLevel units</span>
                                }
                            </td>
                            <td>@item.TotalSales items sold</td>
                            <td>
                                @if (item.StockLevel == 0)
                                {
                                    <span style="background: #fee2e2; color: #b91c1c; padding: 4px 8px; border-radius: 12px; font-size: 0.8rem; font-weight: 600;">Out of Stock</span>
                                }
                                else if (item.StockLevel <= 5)
                                {
                                    <span style="background: #fef3c7; color: #b45309; padding: 4px 8px; border-radius: 12px; font-size: 0.8rem; font-weight: 600;">Restock Needed</span>
                                }
                                else
                                {
                                    <span style="background: #d1fae5; color: #047857; padding: 4px 8px; border-radius: 12px; font-size: 0.8rem; font-weight: 600;">Healthy</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</main>

@* Scripts section is not needed when Layout=null *@
    <!-- Include Chart.js from CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Revenue Chart
            var revCtx = document.getElementById('revenueChart').getContext('2d');
            var revenueDates = @Html.Raw(Json.Serialize(ViewBag.RevenueDates));
            var revenueData = @Html.Raw(Json.Serialize(ViewBag.RevenueData));

            new Chart(revCtx, {
                type: 'line',
                data: {
                    labels: revenueDates,
                    datasets: [{
                        label: 'Revenue (RM)',
                        data: revenueData,
                        borderColor: '#EE4D2D',
                        backgroundColor: 'rgba(238, 77, 45, 0.1)',
                        borderWidth: 2,
                        fill: true,
                        tension: 0.3
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true }
                    }
                }
            });

            // Product Chart
            var prodCtx = document.getElementById('productChart').getContext('2d');
            var prodLabels = @Html.Raw(Json.Serialize(ViewBag.SalesByProductLabels));
            var prodData = @Html.Raw(Json.Serialize(ViewBag.SalesByProductData));

            new Chart(prodCtx, {
                type: 'bar',
                data: {
                    labels: prodLabels,
                    datasets: [{
                        label: 'Units Sold',
                        data: prodData,
                        backgroundColor: [
                            'rgba(59, 130, 246, 0.8)',
                            'rgba(16, 185, 129, 0.8)',
                            'rgba(245, 158, 11, 0.8)',
                            'rgba(239, 68, 68, 0.8)',
                            'rgba(139, 92, 246, 0.8)'
                        ],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true, ticks: { stepSize: 1 } }
                    }
                }
            });
        });
    </script>
</body>
</html>
