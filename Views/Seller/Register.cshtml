@model FYP.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Seller Centre Registration";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SecurePlatform</title>
    <link rel="stylesheet" href="~/css/auth-login.css" />
    <style>
            /* Custom Seller Branding */
            .seller-bg {
                background-color: #F8F9FA;
            }

            .seller-card {
                background: white;
                border-top: 4px solid #F6AD55;
            }

            .seller-primary-btn {
                background: #DD6B20;
                color: white;
                border: none;
                transition: background 0.2s;
                padding: 12px;
                border-radius: 4px;
                font-weight: bold;
                cursor: pointer;
            }

            .seller-primary-btn:hover {
                background: #C05621;
            }
            
            .password-toggle-btn {
                background: none;
                border: none;
                position: absolute;
                right: 10px;
                top: 50%;
                transform: translateY(-50%);
                cursor: pointer;
                color: #718096;
            }
    </style>
</head>
<body class="seller-bg" style="display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">

    <a asp-controller="Home" asp-action="Index" style="position: absolute; top: 25px; left: 30px; color: #4A5568; text-decoration: none; display: flex; align-items: center; font-weight: 500; font-size: 0.95rem; transition: color 0.2s;" onmouseover="this.style.color='#F6AD55'" onmouseout="this.style.color='#4A5568'">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        Back to Home
    </a>

    <div style="display: flex; width: 100%; max-width: 900px; box-shadow: 0 10px 30px rgba(0,0,0,0.08); border-radius: 8px; overflow: hidden;">

        <!-- Left Side: Merchant Marketing & Value Proposition -->
        <div style="flex: 1; background: #2D3748; color: white; padding: 50px; display: flex; flex-direction: column; justify-content: center;">
            <div style="display: flex; align-items: center; margin-bottom: 20px;">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#F6AD55" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 10px;">
                    <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                    <line x1="8" y1="21" x2="16" y2="21"></line>
                    <line x1="12" y1="17" x2="12" y2="21"></line>
                </svg>
                <h2 style="margin: 0; font-size: 1.6rem; letter-spacing: 0.5px;">Seller<span style="color: #F6AD55;">Centre</span></h2>
            </div>
            <h1 style="font-size: 2rem; margin: 0 0 15px 0; line-height: 1.2;">Open Your Store Today.</h1>
            <p style="color: #A0ABC0; font-size: 1rem; line-height: 1.6; margin-bottom: 30px;">
                Join thousands of merchants on SecurePlatform. Expand your reach while we protect your business from fraud.
            </p>

            <div style="display: flex; align-items: center; font-size: 0.9rem; color: #E2E8F0; margin-bottom: 15px;">
                <span style="background: rgba(246, 173, 85, 0.2); color: #F6AD55; padding: 4px 8px; border-radius: 4px; margin-right: 10px; font-weight: bold;">✓</span> Access to millions of buyers
            </div>
            <div style="display: flex; align-items: center; font-size: 0.9rem; color: #E2E8F0; margin-bottom: 15px;">
                <span style="background: rgba(246, 173, 85, 0.2); color: #F6AD55; padding: 4px 8px; border-radius: 4px; margin-right: 10px; font-weight: bold;">✓</span> Automated Fraud Defense
            </div>
            <div style="display: flex; align-items: center; font-size: 0.9rem; color: #E2E8F0;">
                <span style="background: rgba(246, 173, 85, 0.2); color: #F6AD55; padding: 4px 8px; border-radius: 4px; margin-right: 10px; font-weight: bold;">✓</span> Seamless payouts & analytics
            </div>
        </div>

        <!-- Right Side: Registration Form -->
        <div class="seller-card" style="flex: 1; padding: 50px;">
            <h3 style="margin: 0 0 5px 0; color: #2D3748; font-size: 1.4rem;">Merchant Registration</h3>
            <p style="color: #718096; font-size: 0.9rem; margin-bottom: 25px;">Create your seller account credentials.</p>

            @if (!ViewData.ModelState.IsValid)
            {
                <div style="background: #FFF5F5; color: #C53030; padding: 12px; border-radius: 4px; border: 1px solid #FEB2B2; margin-bottom: 20px; font-size: 0.85rem;">
                    @Html.ValidationSummary(true, "", new { @style = "list-style: none; padding: 0; margin: 0;" })
                </div>
            }

            <form asp-controller="Auth" asp-action="Register" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Role" value="Seller" />

                <div class="form-group" style="margin-bottom: 20px;">
                    <label style="font-size: 0.85rem; font-weight: 600; color: #4A5568; margin-bottom: 6px; display: block;">Full Name</label>
                    <input asp-for="Name" placeholder="e.g. Jane Doe" required autofocus
                           style="width: 100%; padding: 10px 12px; border: 1px solid #CBD5E0; border-radius: 4px; font-size: 0.95rem; box-sizing: border-box;" />
                    <span asp-validation-for="Name" style="color: #E53E3E; font-size: 0.8rem; display: block; margin-top: 4px;"></span>
                </div>

                <div class="form-group" style="margin-bottom: 20px;">
                    <label style="font-size: 0.85rem; font-weight: 600; color: #4A5568; margin-bottom: 6px; display: block;">Store Name</label>
                    <input asp-for="StoreName" placeholder="e.g. TechHub Enterprise" required
                           style="width: 100%; padding: 10px 12px; border: 1px solid #CBD5E0; border-radius: 4px; font-size: 0.95rem; box-sizing: border-box;" />
                    <span asp-validation-for="StoreName" style="color: #E53E3E; font-size: 0.8rem; display: block; margin-top: 4px;"></span>
                </div>

                <div class="form-group" style="margin-bottom: 20px;">
                    <label style="font-size: 0.85rem; font-weight: 600; color: #4A5568; margin-bottom: 6px; display: block;">SSM Registration Number (Optional)</label>
                    <input asp-for="SSMNumber" placeholder="e.g. 202301123456"
                           style="width: 100%; padding: 10px 12px; border: 1px solid #CBD5E0; border-radius: 4px; font-size: 0.95rem; box-sizing: border-box;" />
                    <span asp-validation-for="SSMNumber" style="color: #E53E3E; font-size: 0.8rem; display: block; margin-top: 4px;"></span>
                </div>

                <div class="form-group" style="margin-bottom: 20px;">
                    <label style="font-size: 0.85rem; font-weight: 600; color: #4A5568; margin-bottom: 6px; display: block;">Email Address</label>
                    <input asp-for="Email" type="email" placeholder="merchant@store.com" required
                           style="width: 100%; padding: 10px 12px; border: 1px solid #CBD5E0; border-radius: 4px; font-size: 0.95rem; box-sizing: border-box;" />
                    <span asp-validation-for="Email" style="color: #E53E3E; font-size: 0.8rem; display: block; margin-top: 4px;"></span>
                </div>

                <div class="form-group" style="margin-bottom: 20px;">
                    <label style="font-size: 0.85rem; font-weight: 600; color: #4A5568; margin-bottom: 6px; display: block;">Password</label>
                    <div style="position: relative;">
                        <input asp-for="Password" type="password" placeholder="••••••••" required id="passwordInput"
                               style="width: 100%; padding: 10px 12px; border: 1px solid #CBD5E0; border-radius: 4px; font-size: 0.95rem; box-sizing: border-box;" />
                    </div>
                    <span asp-validation-for="Password" style="color: #E53E3E; font-size: 0.8rem; display: block; margin-top: 4px;"></span>
                </div>

                <button type="submit" class="seller-primary-btn" style="width: 100%; margin-top: 10px;">
                    REGISTER AS SELLER
                </button>
            </form>

            <div style="text-align: center; margin-top: 25px; font-size: 0.9rem; color: #718096;">
                Already a merchant? 
                <a asp-controller="Seller" asp-action="Login" style="color: #DD6B20; font-weight: 600; text-decoration: none;" onmouseover="this.style.textDecoration='underline'" onmouseout="this.style.textDecoration='none'">
                    Log in here
                </a>
            </div>
            
            <!-- Note about onboarding for buyers -->
            <div style="text-align: center; margin-top: 15px; font-size: 0.8rem; color: #A0ABC0;">
                Have a buyer account? Upgrade from your <a href="/Seller/Onboard" style="color: #A0ABC0; text-decoration: underline;">Profile Dashboard</a>.
            </div>
        </div>
    </div>
    
    <script src="~/js/password-toggle.js"></script>
</body>
</html>
