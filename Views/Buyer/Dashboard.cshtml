@model IEnumerable<FYP.Models.Entities.Order>
@{
    ViewData["Title"] = "Buyer Portal & Order Tracking";
    Layout = null;
    var notifications = ViewBag.Notifications as IEnumerable<FYP.Models.Entities.Notification>;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SecurePlatform</title>
    <link rel="stylesheet" href="~/css/auth-login.css" />
    <link rel="stylesheet" href="~/css/seller-dashboard.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/buyer-dashboard.css" />
</head>
<body style="background-color: #F8F9FA;">

    <header class="auth-navbar">
        <div class="nav-container">
            <div style="display: flex; align-items: center;">
                <a asp-controller="Home" asp-action="Index" class="brand-group">
                    <svg viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z" /></svg>
                    <span class="brand-text">SecurePlatform</span>
                </a>
                <span class="page-label">Buyer Portal</span>
            </div>
            <div>
                <a asp-controller="Home" asp-action="Index" class="help-link" style="margin-right: 20px;">🛍️ Storefront</a>
                <a asp-controller="Buyer" asp-action="Orders" asp-route-buyerId="@ViewBag.BuyerID" class="help-link" style="margin-right: 20px;">📦 All Orders</a>
                <a asp-controller="Buyer" asp-action="Profile" asp-route-buyerId="@ViewBag.BuyerID" class="help-link" style="margin-right: 20px; font-weight: bold;">🔒 Security Profile</a>
                <a asp-controller="Auth" asp-action="Login" style="color: var(--text-dark); text-decoration: none; font-weight: 600; font-size: 0.9rem;">Log Out</a>
            </div>
        </div>
    </header>

    <main class="buyer-container">

        <div class="buyer-header">
            <div>
                <h1>Welcome Back, @ViewBag.Email</h1>
                <p>Track your orders, review AI-verified transactions, and manage account security.</p>
            </div>
            <a asp-controller="Buyer" asp-action="Profile" asp-route-buyerId="@ViewBag.BuyerID" class="btn-social" style="text-decoration: none; font-weight: 600; background: white; border: 1px solid var(--border-color); padding: 12px 20px;">
                ⚙️ Manage Zero-Trust Settings →
            </a>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div style="background-color: #d4edda; color: #155724; padding: 12px 20px; border-radius: 6px; margin-bottom: 20px; border: 1px solid #c3e6cb; font-weight: 600;">
                ✓ @TempData["SuccessMessage"]
            </div>
        }

        <!-- 4 KPI Performance Metric Cards -->
        <div class="kpi-grid">
            <div class="kpi-card">
                <span class="kpi-label">Total Orders Placed</span>
                <span class="kpi-value">@ViewBag.TotalOrders</span>
            </div>

            <div class="kpi-card highlight">
                <span class="kpi-label">Total Spent (RM)</span>
                <span class="kpi-value">RM @(((decimal)ViewBag.TotalSpent).ToString("0.00"))</span>
            </div>

            <div class="kpi-card">
                <span class="kpi-label">Active Orders</span>
                <span class="kpi-value" style="color: @((int)ViewBag.ActiveOrdersCount > 0 ? "#EE4D2D" : "#333");">
                    @ViewBag.ActiveOrdersCount in transit
                </span>
            </div>

            <div class="kpi-card">
                <span class="kpi-label">Account Protection</span>
                <div style="display: flex; align-items: center; gap: 8px; margin-top: 5px;">
                    @if ((bool)ViewBag.MfaEnabled)
                    {
                        <span class="badge badge-success">🛡️ MFA 2FA Active</span>
                    }
                    else
                    {
                        <span class="badge badge-warning">⚠️ MFA Disabled</span>
                    }
                </div>
            </div>
        </div>

        <!-- Split View: Order History & Notifications Feed -->
        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 25px; align-items: start;">

            <!-- Left Column: Recent Orders -->
            <div class="table-card" style="margin-bottom: 0;">
                <div class="table-header">
                    <h2>Recent Orders</h2>
                    <a asp-controller="Buyer" asp-action="Orders" asp-route-buyerId="@ViewBag.BuyerID" style="color: var(--brand-primary); font-size: 0.85rem; font-weight: 600; text-decoration: none;">View All Orders →</a>
                </div>

                @if (Model != null && Model.Any())
                {
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Order ID</th>
                                <th>Date</th>
                                <th>Total</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                <tr>
                                    <td style="font-family: monospace; font-size: 0.85rem; font-weight: bold;">@order.OrderID</td>
                                    <td style="font-size: 0.85rem; color: var(--text-muted);">@order.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    <td><strong style="color: var(--brand-primary);">RM @order.TotalAmount.ToString("0.00")</strong></td>
                                    <td>
                                        @if (order.Status == "Completed" || order.Status == "Delivered")
                                        {
                                            <span class="badge badge-success">✓ @order.Status</span>
                                        }
                                        else if (order.Status == "Cancelled")
                                        {
                                            <span class="badge badge-danger">✕ Cancelled</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-warning">⏳ @order.Status</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-controller="Buyer" asp-action="OrderDetails" asp-route-orderId="@order.OrderID" style="color: var(--brand-primary); font-size: 0.85rem; font-weight: 600; text-decoration: none;">Details →</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div style="text-align: center; padding: 40px; color: var(--text-muted);">
                        <p>No recent purchases found.</p>
                        <a asp-controller="Home" asp-action="Index" class="btn-submit-primary" style="display: inline-block; width: auto; padding: 8px 20px; margin-top: 10px; text-decoration: none;">Browse Storefront →</a>
                    </div>
                }
            </div>

            <!-- Right Column: System Notifications -->
            <div class="table-card" style="margin-bottom: 0;">
                <div class="table-header">
                    <h2>Notifications Feed</h2>
                </div>

                @if (notifications != null && notifications.Any())
                {
                    <div style="display: flex; flex-direction: column; gap: 12px;">
                        @foreach (var note in notifications)
                        {
                            <div style="padding: 12px; background: #FAFAFA; border: 1px solid var(--border-color); border-left: 3px solid var(--brand-primary); border-radius: 4px;">
                                <div style="display: flex; justify-content: space-between; margin-bottom: 4px;">
                                    <strong style="font-size: 0.85rem; color: var(--text-dark);">@note.Type</strong>
                                    <small style="color: var(--text-muted); font-size: 0.75rem;">ID: @note.NotificationID</small>
                                </div>
                                <p style="margin: 0; font-size: 0.85rem; color: #555; line-height: 1.4;">@note.Content</p>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div style="text-align: center; padding: 30px; color: var(--text-muted); font-size: 0.9rem;">
                        <p>No new notifications.</p>
                    </div>
                }
            </div>

        </div>

    </main>
    @await Html.PartialAsync("_ChatPartial")
</body>
</html>