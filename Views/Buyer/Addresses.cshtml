@model IEnumerable<FYP.Models.Entities.Address>
@{
    ViewData["Title"] = "My Addresses";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/user-profile.css" />


<div class="profile-container">
    <div class="profile-sidebar">
        <div class="user-brief">
            <div class="avatar-circle">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                </svg>
            </div>
            <div class="user-brief-info">
                <div class="username-text">@User.Identity?.Name</div>
                <a href="/Buyer/Profile" class="edit-profile-link">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 20h9"></path>
                        <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                    </svg> Edit Profile
                </a>
            </div>
        </div>
        <nav class="profile-nav">
            <div class="nav-group active">
                <div class="nav-group-header">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                    <span>My Account</span>
                </div>
                <ul class="nav-list">
                    <li><a href="/Buyer/Profile">Profile</a></li>
                    <li><a href="/Buyer/BanksAndCards">Banks & Cards</a></li>
                    <li><a href="/Buyer/Addresses" class="active">Addresses</a></li>
                    <li><a href="/Buyer/ChangePasswordVerify">Change Password</a></li>
                    <li><a href="/Buyer/TrustedDevices">Trusted Devices</a></li>
                </ul>
            </div>
            <div class="nav-group">
                <a href="/Buyer/Orders" class="nav-group-link">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                    <span>My Purchase</span>
                </a>
            </div>
        </nav>
    </div>

    <div class="profile-content">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" style="background-color: #d4edda; color: #155724; border: 1px solid #c3e6cb; padding: 10px; border-radius: 4px; margin-bottom: 20px;">
            @TempData["SuccessMessage"]
        </div>
    }

    <!-- Header Section -->
    <div style="background: white; border-radius: 2px; box-shadow: 0 1px 2px rgba(0,0,0,0.05); padding: 22px 30px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #efefef;">
        <h2 style="font-size: 20px; color: #333; margin: 0; font-weight: 500;">My Addresses</h2>
        <button type="button" onclick="openAddAddressModal()" style="background: #ee4d2d; color: white; border: none; padding: 10px 20px; font-size: 14px; border-radius: 2px; cursor: pointer; display: flex; align-items: center; gap: 8px;">
            <span style="font-size: 18px;">+</span> Add Address
        </button>
    </div>

    <!-- Country Header -->
    <div style="background: white; padding: 20px 30px; border-bottom: 1px solid #efefef;">
        <h3 style="font-size: 18px; color: #333; margin: 0; font-weight: 500;">Malaysia</h3>
    </div>

    <!-- Address List -->
    <div style="background: white; padding: 10px 30px;">
        @if (!Model.Any())
        {
            <div style="padding: 40px 0; text-align: center; color: #999; font-size: 16px;">
                You don't have any saved addresses yet.
            </div>
        }
        else
        {
            foreach (var addr in Model)
            {
                <div style="padding: 20px 0; border-bottom: 1px solid #efefef; display: flex; justify-content: space-between;">
                    <div>
                        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 8px;">
                            <span style="font-size: 16px; font-weight: 600; color: #333;">@addr.FullName</span>
                            <span style="color: #999;">|</span>
                            <span style="font-size: 14px; color: #666;">@addr.PhoneNumber</span>
                        </div>
                        <div style="font-size: 14px; color: #666; line-height: 1.5;">
                            @if (!string.IsNullOrEmpty(addr.UnitNumber)) {
                                <span>@addr.UnitNumber, </span>
                            }
                            @addr.HouseBuildingStreet<br />
                            @addr.StateArea, @addr.PostalCode<br />
                        </div>
                        <div style="margin-top: 10px; display: flex; gap: 8px;">
                            @if (addr.IsDefault)
                            {
                                <span style="border: 1px solid #ee4d2d; color: #ee4d2d; font-size: 10px; padding: 2px 4px; border-radius: 2px; text-transform: uppercase; font-weight: 500;">Default</span>
                            }
                            <span style="border: 1px solid #999; color: #666; font-size: 10px; padding: 2px 4px; border-radius: 2px; text-transform: uppercase; font-weight: 500;">@addr.Label</span>
                        </div>
                    </div>
                    <div style="display: flex; flex-direction: column; align-items: flex-end; justify-content: space-between;">
                        <div style="display: flex; gap: 15px; align-items: center; margin-bottom: 10px;">
                            <button type="button" onclick="openEditAddressModal(@addr.AddressID, '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(addr.FullName))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(addr.PhoneNumber))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(addr.StateArea))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(addr.PostalCode))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(addr.UnitNumber ?? ""))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(addr.HouseBuildingStreet))', '@addr.Label', @addr.IsDefault.ToString().ToLower(), @(addr.Latitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "null"), @(addr.Longitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "null"))" style="background: none; border: none; font-size: 14px; color: #05a; cursor: pointer; padding: 8px;">Edit</button>
                            <form asp-action="DeleteAddress" method="post" style="margin: 0;" onsubmit="return confirm('Delete this address?');">
                                <input type="hidden" name="id" value="@addr.AddressID" />
                                <button type="submit" style="background: none; border: none; font-size: 14px; color: #ee4d2d; cursor: pointer; padding: 8px;">Delete</button>
                            </form>
                        </div>
                        @if (!addr.IsDefault)
                        {
                            <form asp-action="SetDefaultAddress" method="post" style="margin: 0;">
                                <input type="hidden" name="id" value="@addr.AddressID" />
                                <button type="submit" style="background: none; border: 1px solid #ddd; padding: 6px 12px; font-size: 14px; color: #444; border-radius: 2px; cursor: pointer; transition: all 0.2s;" onmouseover="this.style.borderColor='#ee4d2d'; this.style.color='#ee4d2d'" onmouseout="this.style.borderColor='#ddd'; this.style.color='#444'">Set as Default</button>
                            </form>
                        }
                    </div>
                </div>
            }
        }
    </div>
    </div>
</div>

@await Html.PartialAsync("_AddressModalPartial")
