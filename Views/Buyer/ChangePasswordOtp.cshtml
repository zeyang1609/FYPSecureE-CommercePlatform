@model FYP.Models.ViewModels.ChangePasswordOtpViewModel
@{
    ViewData["Title"] = "Verify OTP";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/user-profile.css" />

<div class="profile-container">
    <div class="profile-sidebar">
        <div class="user-brief">
            <div class="avatar-circle">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                </svg>
            </div>
            <div class="user-brief-info">
                <div class="username-text">@User.Identity?.Name</div>
                <a href="/Buyer/Profile" class="edit-profile-link">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 20h9"></path>
                        <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                    </svg> Edit Profile
                </a>
            </div>
        </div>
        <nav class="profile-nav">
            <div class="nav-group active">
                <div class="nav-group-header">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                    <span>My Account</span>
                </div>
                <ul class="nav-list">
                    <li><a href="/Buyer/Profile">Profile</a></li>
                    <li><a href="/Buyer/BanksAndCards">Banks & Cards</a></li>
                    <li><a href="/Buyer/Addresses">Addresses</a></li>
                    <li><a href="/Buyer/ChangePasswordVerify" class="active">Change Password</a></li>
                </ul>
            </div>
            <div class="nav-group">
                <a href="/Buyer/Orders" class="nav-group-link">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                    <span>My Purchase</span>
                </a>
            </div>
        </nav>
    </div>

    <div class="profile-content">
        <div class="content-header">
            <h2>Enter Verification Code</h2>
            <p>We've sent a 6-digit code to your registered email address.</p>
        </div>
        <div class="content-body" style="padding: 30px; max-width: 500px;">
            <style>
                .form-group { position: relative; margin-bottom: 18px; }
                .field-label { font-size: 0.85rem; font-weight: 600; color: #222222; margin-bottom: 6px; display: block; letter-spacing: 0.3px; text-align: left; }
                .input-wrapper { position: relative; display: flex; align-items: center; }
                .mvc-input { width: 100%; padding: 13px 14px; border: 1px solid #E0E0E0; border-radius: 4px; font-size: 0.95rem; outline: none; transition: all 0.2s ease; }
                .mvc-input:focus { border-color: #EE4D2D; box-shadow: 0 0 0 2px rgba(238, 77, 45, 0.15); }
                .btn-submit-primary { width: 100%; padding: 13px; background-color: #EE4D2D; color: #FFFFFF; border: none; border-radius: 4px; font-size: 1rem; font-weight: 600; letter-spacing: 0.5px; cursor: pointer; box-shadow: 0 2px 6px rgba(238, 77, 45, 0.3); transition: background-color 0.2s; margin-top: 10px; }
                .btn-submit-primary:hover { background-color: #D73211; }
                .field-validation-error { color: #d9534f; font-size: 0.8rem; display: block; margin-top: 5px; text-align: left; }
            </style>

            <form asp-action="ChangePasswordOtp" method="post">
                @Html.AntiForgeryToken()
                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ContainsKey(string.Empty) && ViewData.ModelState[string.Empty].Errors.Count > 0)
                {
                    <div id="loginErrorMsg" style="color: #ee4d2d; font-size: 13px; margin-bottom: 15px; text-align: left;">
                        @foreach (var error in ViewData.ModelState[string.Empty].Errors)
                        {
                            <div>@error.ErrorMessage</div>
                        }
                    </div>
                }

                <div class="form-group">
                    <label asp-for="OtpCode" class="field-label">6-Digit Verification Code</label>
                    <div class="input-wrapper">
                        <input asp-for="OtpCode" type="text" class="mvc-input" placeholder="Enter OTP code" autofocus />
                    </div>
                    <span asp-validation-for="OtpCode" class="field-validation-error"></span>
                </div>
                
                <button type="submit" class="btn-submit-primary">Verify Code</button>
            </form>
        </div>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
<script>
    $(document).ready(function() {
        $('.mvc-input').on('input', function() {
            $('#loginErrorMsg').hide();
        });
    });
</script>
