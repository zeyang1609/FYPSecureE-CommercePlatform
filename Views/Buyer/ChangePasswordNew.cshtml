@model FYP.Models.ViewModels.ChangePasswordNewViewModel
@{
    ViewData["Title"] = "Set New Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/user-profile.css" />

<div class="profile-container">
    @await Html.PartialAsync("_BuyerSidebarPartial")

    <div class="profile-content">
        <div class="content-header">
            <h2>Set New Password</h2>
            <p>Enter your new password below.</p>
        </div>
        <div class="content-body">
            <div class="profile-form-section" style="max-width: 700px; padding-top: 20px;">
                <form asp-action="ChangePasswordNew" method="post">
                    @Html.AntiForgeryToken()
                    
                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ContainsKey(string.Empty) && ViewData.ModelState[string.Empty].Errors.Count > 0)
                    {
                        <div class="form-row">
                            <label></label>
                            <div class="form-field">
                                <div id="loginErrorMsg" style="color: #ee4d2d; font-size: 13px; text-align: left; background: #fff8f8; border: 1px solid #ffd2d2; padding: 10px; width: 100%; border-radius: 2px;">
                                    @foreach (var error in ViewData.ModelState[string.Empty].Errors)
                                    {
                                        <div>@error.ErrorMessage</div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ContainsKey("NewPassword") && ViewData.ModelState["NewPassword"].Errors.Count > 0)
                    {
                        <div class="form-row">
                            <label></label>
                            <div class="form-field">
                                <div id="loginErrorMsg" style="color: #ee4d2d; font-size: 13px; text-align: left; background: #fff8f8; border: 1px solid #ffd2d2; padding: 10px; width: 100%; border-radius: 2px;">
                                    @foreach (var error in ViewData.ModelState["NewPassword"].Errors)
                                    {
                                        <div>@error.ErrorMessage</div>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    <div class="form-row">
                        <label asp-for="NewPassword">New Password</label>
                        <div class="form-field" style="flex-direction: column; align-items: flex-start; gap: 5px;">
                            <input asp-for="NewPassword" id="newPasswordInput" type="password" class="form-control" placeholder="Enter new password" autofocus />
                            <span asp-validation-for="NewPassword" class="text-danger" style="font-size: 0.8rem; margin-top: 5px; display: block;"></span>
                        </div>
                    </div>

                    <div class="form-row">
                        <label asp-for="ConfirmPassword">Confirm Password</label>
                        <div class="form-field" style="flex-direction: column; align-items: flex-start; gap: 5px;">
                            <input asp-for="ConfirmPassword" id="confirmPasswordInput" type="password" class="form-control" placeholder="Retype new password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size: 0.8rem;"></span>
                        </div>
                    </div>
                    
                    <div class="form-row">
                        <label></label>
                        <div class="form-field">
                            <button type="submit" class="btn-submit-primary" style="width: auto; background-color: #EE4D2D; color: #FFFFFF; border: none; border-radius: 2px; padding: 10px 25px; font-weight: 500; cursor: pointer; transition: background 0.2s;">Save Password</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
<script>
    $(document).ready(function() {
        $('.mvc-input').on('input', function() {
            $('#loginErrorMsg').hide();
        });
    });
</script>
