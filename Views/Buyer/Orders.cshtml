@model IEnumerable<FYP.Models.Entities.Order>
@{
    ViewData["Title"] = "My Orders";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SecurePlatform</title>
    <link rel="stylesheet" href="~/css/auth-login.css" />
    <link rel="stylesheet" href="~/css/seller-dashboard.css" />
    <link rel="stylesheet" href="~/css/buyer-dashboard.css" />
</head>
<body style="background-color: #F8F9FA;">

    <header class="auth-navbar">
        <div class="nav-container">
            <div style="display: flex; align-items: center;">
                <a asp-controller="Home" asp-action="Index" class="brand-group">
                    <svg viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z" /></svg>
                    <span class="brand-text">SecurePlatform</span>
                </a>
                <span class="page-label">Order History</span>
            </div>
            <div>
                <a asp-controller="Buyer" asp-action="Dashboard" asp-route-buyerId="@ViewBag.BuyerID" class="help-link" style="font-weight: 600;">← Back to Portal</a>
            </div>
        </div>
    </header>

    <main class="buyer-container">

        <div class="buyer-header">
            <div>
                <h1>Full Order History</h1>
                <p>Reviewing all purchases and algorithmic fraud verifications for Buyer ID: <strong>@ViewBag.BuyerID</strong></p>
            </div>
            <span class="qr-pill" style="font-size: 0.9rem; padding: 8px 14px;">🛡️ XGBoost Protected</span>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div style="background-color: #d4edda; color: #155724; padding: 12px 20px; border-radius: 6px; margin-bottom: 20px; border: 1px solid #c3e6cb; font-weight: 600;">
                ✓ @TempData["SuccessMessage"]
            </div>
        }

        <div class="table-card">
            @if (Model != null && Model.Any())
            {
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>Order Date</th>
                            <th>Items Summary</th>
                            <th>Payment Method</th>
                            <th>Total Amount</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            var firstItem = order.OrderItems.FirstOrDefault();
                            int totalQty = order.OrderItems.Sum(i => i.Quantity);
                            <tr>
                                <td style="font-family: monospace; font-size: 0.85rem; font-weight: bold;">@order.OrderID</td>
                                <td style="font-size: 0.85rem; color: var(--text-muted);">@order.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                                <td>
                                    <strong style="font-size: 0.95rem; display: block;">@(firstItem?.Product?.Title ?? "Order Package")</strong>
                                    <small style="color: var(--text-muted);">@totalQty item(s) included</small>
                                </td>
                                <td><span style="background: #F0F0F0; padding: 4px 8px; border-radius: 4px; font-size: 0.8rem;">@(order.Payment?.PaymentMethod ?? "Online Gateway")</span></td>
                                <td><strong style="color: var(--brand-primary); font-size: 1.05rem;">RM @order.TotalAmount.ToString("0.00")</strong></td>
                                <td>
                                    @if (order.Status == "Completed" || order.Status == "Delivered")
                                    {
                                        <span class="badge badge-success">✓ @order.Status</span>
                                    }
                                    else if (order.Status == "Cancelled")
                                    {
                                        <span class="badge badge-danger">✕ Cancelled</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-warning">⏳ @order.Status</span>
                                    }
                                </td>
                                <td>
                                    <a asp-controller="Buyer" asp-action="OrderDetails" asp-route-orderId="@order.OrderID" class="btn-submit-primary" style="width: auto; padding: 6px 14px; font-size: 0.8rem; text-decoration: none; display: inline-block;">View Details</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div style="text-align: center; padding: 40px; color: var(--text-muted);">
                    <h3>No orders placed yet.</h3>
                    <p>Your complete purchase history will appear here once you check out.</p>
                </div>
            }
        </div>
    </main>
</body>
</html>