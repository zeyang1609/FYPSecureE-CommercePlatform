@model FYP.Models.ViewModels.BuyerProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}



<link rel="stylesheet" href="~/css/user-profile.css" />

<div class="profile-container">
    <div class="profile-sidebar">
        <div class="user-brief">
            <div class="avatar-circle">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                </svg>
            </div>
            <div class="user-brief-info">
                <div class="username-text">@(string.IsNullOrEmpty(Model.Name) ? Model.Email.Split('@')[0] : Model.Name)</div>
                <a href="#" class="edit-profile-link">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 20h9"></path>
                        <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                    </svg> Edit Profile
                </a>
            </div>
        </div>
        <nav class="profile-nav">
            <div class="nav-group active">
                <div class="nav-group-header">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                    <span>My Account</span>
                </div>
                <ul class="nav-list">
                    <li><a href="/Buyer/Profile" class="active">Profile</a></li>
                    <li><a href="/Buyer/BanksAndCards">Banks & Cards</a></li>
                    <li><a href="/Buyer/Addresses">Addresses</a></li>
                    <li><a href="/Buyer/ChangePasswordVerify">Change Password</a></li>
                </ul>
            </div>
            <div class="nav-group">
                <a href="/Buyer/Orders" class="nav-group-link">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                    <span>My Purchase</span>
                </a>
            </div>
            <div class="nav-group">
                <a href="#" class="nav-group-link">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
                    <span>Notifications</span>
                </a>
            </div>
        </nav>
    </div>

    <div class="profile-content">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert" style="margin: 0 30px 20px 30px; background-color: #d4edda; color: #155724; padding: 15px; border-radius: 4px; border: 1px solid #c3e6cb;">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger" style="margin: 0 30px 20px 30px; padding: 15px; border-radius: 4px;">@TempData["ErrorMessage"]</div>
        }

        <div id="profile-view-block" style="display: @(ViewBag.EmailChangeStep == null && ViewBag.PhoneChangeStep == null ? "block" : "none");">
            <div class="content-header">
                <h2>My Profile</h2>
                <p>Manage and protect your account</p>
            </div>
            <div class="content-body">
                <div class="profile-form-section">
                <form asp-action="UpdateProfile" method="post">
                    <input type="hidden" asp-for="UserID" />
                    
                    <div class="form-row">
                        <label>Username</label>
                        <div class="form-field">
                            <span class="static-text" style="color: #333; font-weight: 500;">@Model.Email.Split('@')[0]</span>
                        </div>
                    </div>
                    <div class="form-row">
                        <label asp-for="Name"></label>
                        <div class="form-field">
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-row">
                        <label>Email</label>
                        <div class="form-field">
                            <input type="hidden" asp-for="Email" />
                            @{
                                var email = Model.Email ?? "";
                                var parts = email.Split('@');
                                var maskedEmail = parts.Length == 2 && parts[0].Length > 2 
                                    ? parts[0].Substring(0, 2) + new string('x', parts[0].Length - 2) + "@" + parts[1] 
                                    : email;
                            }
                            <span class="static-text" style="color: #333;">@maskedEmail</span>
                            <button type="button" onclick="showEmailChange()" class="btn btn-link p-0 ms-3 text-decoration-underline" style="color: #0055AA; font-size: 13px; border: none; cursor: pointer;">Change</button>
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-row">
                        <label>Phone Number</label>
                        <div class="form-field">
                            <input type="hidden" asp-for="PhoneNumber" />
                            @{
                                var phone = Model.PhoneNumber ?? "";
                                var maskedPhone = phone.Length > 2 
                                    ? new string('x', phone.Length - 2) + phone.Substring(phone.Length - 2) 
                                    : phone;
                            }
                            <span class="static-text" style="color: #333;">@(string.IsNullOrEmpty(maskedPhone) ? "Not set" : maskedPhone)</span>
                            <button type="button" onclick="showPhoneChange()" class="btn btn-link p-0 ms-3 text-decoration-underline" style="color: #0055AA; font-size: 13px; border: none; cursor: pointer;">Change</button>
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-row">
                        <label>Gender</label>
                        <div class="form-field radio-group">
                            <label><input type="radio" asp-for="Gender" value="Male" /> Male</label>
                            <label><input type="radio" asp-for="Gender" value="Female" /> Female</label>
                            <label><input type="radio" asp-for="Gender" value="Other" /> Other</label>
                        </div>
                    </div>
                    <div class="form-row">
                        <label>Date of birth</label>
                        <div class="form-field">
                            <input type="hidden" asp-for="DateOfBirth" id="hidden-dob" />
                            @{
                                var dobText = Model.DateOfBirth.HasValue 
                                    ? "xx/xx/" + Model.DateOfBirth.Value.Year 
                                    : "Not set";
                            }
                            <div id="dob-display-section" style="display: flex; align-items: center;">
                                <span class="static-text" style="color: #333;">@dobText</span>
                                <button type="button" onclick="showDobEdit()" class="btn btn-link p-0 ms-3 text-decoration-underline" style="color: #0055AA; font-size: 13px; border: none; cursor: pointer;">Change</button>
                            </div>
                            
                            <div id="dob-edit-section" style="display: none; gap: 10px; align-items: center;">
                                <select id="dob-day" class="form-control" style="width: auto; min-width: 80px; padding: 6px 12px; font-size: 14px;">
                                    <option value="">Date</option>
                                    @for(int i=1; i<=31; i++) {
                                        if (Model.DateOfBirth?.Day == i) { <option value="@i" selected>@i</option> }
                                        else { <option value="@i">@i</option> }
                                    }
                                </select>
                                <select id="dob-month" class="form-control" style="width: auto; min-width: 90px; padding: 6px 12px; font-size: 14px;">
                                    <option value="">Month</option>
                                    @for(int i=1; i<=12; i++) {
                                        if (Model.DateOfBirth?.Month == i) { <option value="@i" selected>@i</option> }
                                        else { <option value="@i">@i</option> }
                                    }
                                </select>
                                <select id="dob-year" class="form-control" style="width: auto; min-width: 90px; padding: 6px 12px; font-size: 14px;">
                                    <option value="">Year</option>
                                    @{ int currentYear = DateTime.Now.Year; }
                                    @for(int i=currentYear; i>=1900; i--) {
                                        if (Model.DateOfBirth?.Year == i) { <option value="@i" selected>@i</option> }
                                        else { <option value="@i">@i</option> }
                                    }
                                </select>
                            </div>
                            
                            <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-row" style="align-items: flex-start;">
                        <label style="line-height: 1.4;">Enable<br/>Multi-Factor<br/>Authentication<br/>(MFA)</label>
                        <div class="form-field checkbox-group" style="padding-top: 10px;">
                            <input asp-for="MfaEnabled" type="checkbox" />
                            <span style="margin-left: 8px;">Enable Two-Factor Authentication</span>
                        </div>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn-save">Save</button>
                    </div>
                </form>
            </div>
            <div class="profile-avatar-section">
                <div class="avatar-circle mb-3 d-flex align-items-center justify-content-center shadow" style="width: 100px; height: 100px; background-color: #f0f0f0; color: #EE4D2D; border-radius: 50%; border: 1px solid #e0e0e0; font-size: 36px; font-weight: bold;">
                    @(string.IsNullOrEmpty(Model.Name) ? Model.Email.Substring(0, 1).ToUpper() : Model.Name.Substring(0, 1).ToUpper())
                </div>
                <button type="button" class="btn-select-image">Select Image</button>
                <div class="avatar-hints">
                    File size: maximum 1 MB<br/>
                    File extension: .JPEG, .PNG
                </div>
            </div>
        </div>
        </div>

        <div id="change-phone" style="display: @(ViewBag.PhoneChangeStep != null ? "block" : "none");">
            <div class="content-header" style="display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <h2>Change Phone Number</h2>
                    <p>Enter your new Malaysian phone number</p>
                </div>
                <a href="/Buyer/Profile" class="btn btn-outline-secondary" style="font-size: 13px; border-radius: 2px; padding: 6px 12px; background: white; border: 1px solid #ccc; cursor: pointer; text-decoration: none; color: #333;">&larr; Back to Profile</a>
            </div>
            <div class="content-body" style="padding-top: 10px;">
                <form asp-action="ChangePhoneNumber" method="post" style="width: 100%;">

                    <div class="form-row">
                        <label>New Phone Number</label>
                        <div class="form-field">
                            <input type="tel" id="newPhoneNumberInput" name="newPhoneNumber" class="form-control" placeholder="+601x-xxxxxxx" required maxlength="13" style="max-width: 250px;" />
                            <div style="font-size: 12px; color: #999; margin-top: 5px;">Format: 01x-xxxxxxx or +601x-xxxxxxx</div>
                        </div>
                    </div>
                    @if (ViewBag.PhoneChangeError != null)
                    {
                        <div class="form-row" style="margin-top: 0;">
                            <label></label>
                            <div class="form-field">
                                <div style="color: #dc3545; font-size: 13px; padding: 8px 12px; background: #fff5f5; border: 1px solid #f5c6cb; border-radius: 4px;">@ViewBag.PhoneChangeError</div>
                            </div>
                        </div>
                    }
                    <div class="form-row" style="margin-top: 30px;">
                        <label></label>
                        <div class="form-field">
                            <button type="submit" class="btn-save" style="padding: 10px 40px; background-color: #ee4d2d; color: #fff; border: none; border-radius: 2px; cursor: pointer;">Save</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div id="change-email-step1" style="display: none;">
            <div class="content-header" style="display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <h2>Change Email Address</h2>
                    <p>Enter your new email address for verification</p>
                </div>
                <button type="button" onclick="showProfileView()" class="btn btn-outline-secondary" style="font-size: 13px; border-radius: 2px; padding: 6px 12px; background: white; border: 1px solid #ccc; cursor: pointer;">&larr; Back to Profile</button>
            </div>
            <div class="content-body" style="padding-top: 10px;">
                <form id="email-change-form" asp-action="InitiateEmailChange" method="post" style="width: 100%;">
                    <div class="form-row">
                        <label>Current Email</label>
                        <div class="form-field">
                            <span class="static-text" style="color: #333; font-weight: 500;">@Model.Email</span>
                        </div>
                    </div>
                    <div class="form-row">
                        <label>New Email:</label>
                        <div class="form-field">
                            <input type="email" name="newEmail" class="form-control" placeholder="Enter new email address" required style="max-width: 300px;" />
                        </div>
                    </div>
                    <div class="form-row" style="margin-top: 40px;">
                        <label></label>
                        <div class="form-field">
                            <button type="submit" class="btn-save" style="padding: 10px 40px; background-color: #ee4d2d; color: #fff; border: none; border-radius: 2px; cursor: pointer;">Next</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        @if (ViewBag.EmailChangeStep as int? == 2)
        {
        <div id="change-email-step2" style="display: block;">
            <div class="content-header" style="display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <h2>Verification Required</h2>
                    <p>Enter the 6-digit code sent to <strong>@ViewBag.PendingNewEmail</strong></p>
                </div>
                <a href="/Buyer/Profile" class="btn btn-outline-secondary" style="font-size: 13px; border-radius: 2px; padding: 6px 12px; background: white; border: 1px solid #ccc; cursor: pointer; text-decoration: none; color: #333;">&larr; Cancel</a>
            </div>
            <div class="content-body" style="padding-top: 10px;">
                <form id="email-verify-form" asp-action="VerifyEmailChange" method="post" style="width: 100%;">
                    <input type="hidden" name="pendingEmail" value="@ViewBag.PendingNewEmail" />
                    <div class="form-row">
                        <label>Verification Code</label>
                        <div class="form-field">
                            <input type="text" name="otpCode" class="form-control" placeholder="123456" required maxlength="6" style="max-width: 150px; letter-spacing: 4px; font-weight: bold; text-align: center;" />
                        </div>
                    </div>
                    <div class="form-row" style="margin-top: 5px;">
                        <label></label>
                        <div class="form-field">
                            <div id="otp-timer-container" style="font-size: 13px; color: #666;">
                                Code expires in <span id="time-left" style="font-weight: 500; color: #ee4d2d;">05:00</span>
                            </div>
                            <div id="resend-container" style="display: none; margin-top: 4px;"></div>
                        </div>
                    </div>
                    <div class="form-row" style="margin-top: 30px;">
                        <label></label>
                        <div class="form-field">
                            <button type="submit" class="btn-save" style="padding: 10px 40px;">Verify & Save</button>
                        </div>
                    </div>
                </form>
                <!-- Resend form is separate (not nested) -->
                <form id="resend-form" asp-action="InitiateEmailChange" method="post" style="display: none;">
                    <input type="hidden" name="newEmail" value="@ViewBag.PendingNewEmail" />
                </form>
            </div>
        </div>
        }

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function showEmailChange() {
            document.getElementById('profile-view-block').style.display = 'none';
            document.getElementById('change-email-step1').style.display = 'block';
        }
        function showProfileView() {
            document.getElementById('change-email-step1').style.display = 'none';
            document.getElementById('change-phone').style.display = 'none';
            document.getElementById('profile-view-block').style.display = 'block';
        }
        function showPhoneChange() {
            document.getElementById('profile-view-block').style.display = 'none';
            document.getElementById('change-phone').style.display = 'block';
        }
        function showDobEdit() {
            document.getElementById('dob-display-section').style.display = 'none';
            document.getElementById('dob-edit-section').style.display = 'flex';
        }

        // DOB Dropdown Logic
        const dobDay = document.getElementById('dob-day');
        const dobMonth = document.getElementById('dob-month');
        const dobYear = document.getElementById('dob-year');
        const hiddenDob = document.getElementById('hidden-dob');

        function updateHiddenDob() {
            if (dobDay.value && dobMonth.value && dobYear.value) {
                // format: YYYY-MM-DD for model binding
                let m = dobMonth.value.padStart(2, '0');
                let d = dobDay.value.padStart(2, '0');
                hiddenDob.value = `${dobYear.value}-${m}-${d}`;
            } else {
                hiddenDob.value = '';
            }
        }

        if (dobDay && dobMonth && dobYear) {
            dobDay.addEventListener('change', updateHiddenDob);
            dobMonth.addEventListener('change', updateHiddenDob);
            dobYear.addEventListener('change', updateHiddenDob);
        }

        // OTP Timer Logic
        const timerSpan = document.getElementById('time-left');
        const resendForm = document.getElementById('resend-form');
        const resendContainer = document.getElementById('resend-container');
        const timerContainer = document.getElementById('otp-timer-container');
        
        if (timerSpan) {
            // Always reset the timer on a fresh server-rendered page load
            // The page only renders step2 after a redirect from InitiateEmailChange
            sessionStorage.removeItem('otpEndTime');
            let endTime = Date.now() + 5 * 60 * 1000;
            sessionStorage.setItem('otpEndTime', endTime);

            const timer = setInterval(() => {
                let timeLeft = Math.round((parseInt(endTime) - Date.now()) / 1000);
                
                if (timeLeft <= 0) {
                    clearInterval(timer);
                    timerContainer.innerHTML = "Code expired.";
                    if (resendContainer && resendForm) {
                        resendContainer.style.display = 'block';
                        resendContainer.innerHTML = '<a href="#" id="resend-link" style="font-size: 13px; color: #0055AA; text-decoration: underline; cursor: pointer;">Resend Code</a>';
                        document.getElementById('resend-link').addEventListener('click', function(e) {
                            e.preventDefault();
                            sessionStorage.removeItem('otpEndTime');
                            resendForm.submit();
                        });
                    }
                } else {
                    let m = Math.floor(timeLeft / 60);
                    let s = timeLeft % 60;
                    timerSpan.innerText = (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
                }
            }, 1000);
        }
        
        // Auto-prefix phone number
        const phoneInput = document.getElementById('newPhoneNumberInput');
        if (phoneInput) {
            phoneInput.addEventListener('focus', function() {
                if (!this.value) {
                    this.value = '+601';
                }
            });
            phoneInput.addEventListener('input', function() {
                // Handle pasting or modifying prefix
                if (!this.value.startsWith('+601')) {
                    if (this.value.startsWith('01')) {
                        this.value = '+60' + this.value.substring(1);
                    } else if (this.value.startsWith('601')) {
                        this.value = '+' + this.value;
                    } else {
                        this.value = '+601';
                    }
                }
                // Strip non-digits after the prefix
                const prefix = '+601';
                const rest = this.value.substring(prefix.length).replace(/[^\d]/g, '');
                this.value = prefix + rest;
            });
            phoneInput.addEventListener('blur', function() {
                if (this.value === '+601') {
                    this.value = '';
                }
            });
        }
    </script>
}
