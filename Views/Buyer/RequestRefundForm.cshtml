@model FYP.Models.Entities.Order
@{
    ViewData["Title"] = "Request Return/Refund";
    Layout = null;
    var issueType = ViewBag.IssueType as string;
    var firstItem = Model.OrderItems.FirstOrDefault();
    var sellerName = firstItem?.Product?.Seller?.Name ?? "Various Sellers";
    ViewData["ReturnUrl"] = $"/Buyer/RequestRefundForm?orderId={Model.OrderID}&issueType={issueType}";
    var delivery = ViewBag.Delivery as FYP.Models.Entities.Delivery;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SecurePlatform</title>
    <link rel="stylesheet" href="~/css/auth-login.css" />
    <link rel="stylesheet" href="~/css/buyer-dashboard.css" />
    <link rel="stylesheet" href="~/css/buyer-orders.css" />
    <style>
        .refund-container {
            width: 100%;
            max-width: 1200px;
            margin: 30px auto 60px auto;
            padding: 0 5%;
        }
        
        .section-box {
            background-color: #ffffff;
            border-radius: 4px;
            box-shadow: 0 1px 1px 0 rgba(0,0,0,.05);
            margin-bottom: 12px;
            padding: 24px;
            width: 100%;
        }

        .section-title {
            font-size: 18px;
            font-weight: 500;
            color: #222;
            margin-bottom: 16px;
        }

        .issue-type-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background-color: #fafafa;
            padding: 16px;
            border-radius: 4px;
            border: 1px solid #eee;
        }

        .form-group {
            margin-bottom: 16px;
        }

        .form-label {
            display: block;
            margin-bottom: 8px;
            font-weight: 500;
            color: #333;
        }

        .form-control {
            width: 100%;
            padding: 10px 14px;
            border: 1px solid #e5e5e5;
            border-radius: 2px;
            font-size: 14px;
            outline: none;
        }
        
        .form-control:focus {
            border-color: #ee4d2d;
        }

        textarea.form-control {
            resize: vertical;
            height: 120px;
        }

        .media-upload-area {
            border: 1px dashed #ee4d2d;
            background-color: #fff9f8;
            padding: 30px;
            text-align: center;
            border-radius: 4px;
            cursor: pointer;
            margin-top: 8px;
        }

        .media-upload-area:hover {
            background-color: #fff0ed;
        }

        .footer-action {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 30px;
            padding-top: 20px;
            border-top: 1px solid #eee;
        }
    </style>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body style="background-color: #f5f5f5;">

    <header class="auth-navbar">
        <div class="nav-container">
            <div style="display: flex; align-items: center;">
                <a asp-controller="Home" asp-action="Index" class="brand-group">
                    <svg viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z" /></svg>
                    <span class="brand-text">SecurePlatform</span>
                </a>
                <span class="page-label">Request Return/Refund</span>
            </div>
            <div>
                <a asp-controller="Buyer" asp-action="Orders" class="help-link" style="font-weight: 600;">← Back to Orders</a>
            </div>
        </div>
    </header>

    <main class="refund-container">

        @if (TempData["ErrorMessage"] != null)
        {
            <div style="background-color: #f8d7da; color: #721c24; padding: 12px 20px; border-radius: 4px; margin-bottom: 12px; border: 1px solid #f5c6cb; font-size: 14px;">
                @TempData["ErrorMessage"]
            </div>
        }

        <form id="refundForm" asp-controller="Buyer" asp-action="SubmitRefundRequest" method="post" enctype="multipart/form-data" onsubmit="return validateRefundForm()">
            <input type="hidden" name="orderId" value="@Model.OrderID" />
            <input type="hidden" name="issueType" value="@issueType" />

            <!-- Section 1: What happened -->
            <div class="section-box">
                <h3 class="section-title">What happened to your order?</h3>
                <div class="issue-type-row">
                    <span style="font-weight: 500;">@issueType</span>
                    <button type="button" class="btn-action secondary" style="padding: 6px 12px; min-width: auto;" onclick="document.getElementById('changeIssueModal').style.display='flex'">Change</button>
                </div>
            </div>

            <!-- Section 2: Items -->
            <div class="section-box">
                <h3 class="section-title">Item(s) you want to return</h3>
                <div class="seller-info" style="margin-bottom: 12px;">
                    <span class="seller-name">@sellerName</span>
                </div>
                @foreach(var item in Model.OrderItems)
                {
                    <div class="order-item">
                        <div class="item-image">
                            <img src="~/uploads/@(item.ProductID).jpg" alt="@item.Product.Title" onerror="this.src='/images/default-product.jpg';" />
                        </div>
                        <div class="item-details">
                            <div class="item-title">@item.Product.Title</div>
                            <div class="item-variation">Variation, color, model</div>
                            <div class="item-qty">x@(item.Quantity)</div>
                        </div>
                        <div class="item-price">
                            RM @item.UnitPrice.ToString("0.00")
                        </div>
                    </div>
                }
            </div>

            <!-- Section 3: Reason & Proof -->
            <div class="section-box">
                <h3 class="section-title">Why do you want to return/refund?</h3>
                
                <div class="form-group" style="display: flex; align-items: center;">
                    <label class="form-label" style="width: 200px; margin-bottom: 0;">Reason:</label>
                    <div style="flex: 1; max-width: 400px; position: relative;">
                        <select name="reason" id="reasonSelect" class="form-control" style="width: 100%;">
                            <option value="" selected disabled>Select a reason</option>
                            @if (issueType == "Did Not Receive Some/All of the Item(s)")
                            {
                                <option value="Parcel Not delivered">Parcel Not delivered</option>
                                <option value="Missing part of the order">Missing part of the order</option>
                                <option value="Empty/Tampered Parcel">Empty/Tampered Parcel</option>
                            }
                            else
                            {
                                <option value="Damaged Item">Damaged Item</option>
                                <option value="Wrong Item Sent">Wrong Item Sent</option>
                                <option value="Missing Parts">Missing Parts</option>
                                <option value="Item not as described">Item not as described</option>
                                <option value="Change of Mind">Change of Mind</option>
                            }
                        </select>
                        <div id="reasonErrorMsg" style="color: #ee4d2d; font-size: 12px; margin-top: 4px; display: none;">Please provide a reason</div>
                    </div>
                </div>

                <div class="form-group" style="display: flex; align-items: flex-start; margin-top: 20px;">
                    <label class="form-label" style="width: 200px; margin-bottom: 0; padding-top: 10px;">Description:</label>
                    <div style="flex: 1; max-width: 400px;">
                        <textarea name="description" class="form-control" placeholder="Please describe the issue in detail..." maxlength="1000" required style="resize: none;"></textarea>
                        <div style="text-align: right; font-size: 12px; color: #999; margin-top: 4px;">Maximum 1000 words</div>
                    </div>
                </div>

                <div class="form-group" style="display: flex; align-items: flex-start; margin-top: 20px;">
                    <label class="form-label" style="width: 200px; margin-bottom: 0; padding-top: 10px;">Provide clear photo/video showing:</label>
                    
                    <div style="flex: 1; max-width: 500px;">

                        <ol id="proofInstructionsList" style="font-size: 13px; color: #666; margin: 0 0 16px 20px; padding-top: 10px;">
                            <li>Content of the parcel received</li>
                            <li>Packaging from all angles</li>
                        </ol>

                        <div style="display: flex; gap: 8px; align-items: flex-start; flex-wrap: wrap;" id="refundMediaUploadArea">
                            <!-- Image previews inserted here by JS -->
                            <div id="refundImagePreview" style="display: contents;"></div>
                            <!-- Add Photo placeholder box (Shopee style) -->
                            <div style="text-align: center;">
                                <div id="refundAddPhotoBox" onclick="document.getElementById('imageUpload').click()" style="width: 72px; height: 72px; border: 1px dashed #ccc; background: #fafafa; display: flex; flex-direction: column; align-items: center; justify-content: center; cursor: pointer; border-radius: 2px; gap: 2px;">
                                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#bbb" stroke-width="1.5"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
                                    <span style="font-size: 10px; color: #999;">Add Photo</span>
                                    <span id="refundImageCount" style="font-size: 10px; color: #bbb;">(0/5)</span>
                                </div>
                                <div style="font-size: 10px; color: #999; margin-top: 4px;">Max: 20MB</div>
                            </div>
                            <input type="file" name="imageFiles" id="imageUpload" style="display: none;" accept="image/*" multiple onchange="handleRefundImageUpload(this);" />

                            <!-- Video previews inserted here by JS -->
                            <div id="refundVideoPreview" style="display: contents;"></div>
                            <!-- Add Video placeholder box (Shopee style) -->
                            <div style="text-align: center;">
                                <div id="refundAddVideoBox" onclick="document.getElementById('videoUpload').click()" style="width: 72px; height: 72px; border: 1px dashed #ccc; background: #fafafa; display: flex; flex-direction: column; align-items: center; justify-content: center; cursor: pointer; border-radius: 2px; gap: 2px;">
                                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#bbb" stroke-width="1.5"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg>
                                    <span style="font-size: 10px; color: #999;">Add Video</span>
                                    <span id="refundVideoCount" style="font-size: 10px; color: #bbb;">(0/1)</span>
                                </div>
                                <div style="font-size: 10px; color: #999; margin-top: 4px;">Max: 200MB</div>
                            </div>
                            <input type="file" name="videoFile" id="videoUpload" style="display: none;" accept="video/*" onchange="handleRefundVideoUpload(this);" />
                        </div>

                        <script>
                            document.getElementById('reasonSelect').addEventListener('change', function() {
                                const reason = this.value;
                                const list = document.getElementById('proofInstructionsList');
                                
                                if (reason === 'Damaged Item') {
                                    list.innerHTML = '<li>Damaged conditions of the product</li><li>Packaging from all angles</li>';
                                } else if (reason === 'Wrong Item Sent') {
                                    list.innerHTML = '<li>Wrong product received</li><li>Packaging from all angles with clear Airway Bill</li>';
                                } else if (reason === 'Change of Mind') {
                                    list.innerHTML = '<li>Product is still in sealed and unused condition</li>';
                                } else if (reason === 'Missing part of the order') {
                                    list.innerHTML = '<li>Content of the parcel received</li><li>Packaging from all angles</li>';
                                } else if (reason === 'Empty/Tampered Parcel') {
                                    list.innerHTML = '<li>Parcel received that is empty</li><li>Packaging with clear Airway Bill</li>';
                                } else {
                                    list.innerHTML = '<li>Content of the parcel received</li><li>Packaging from all angles</li>';
                                }

                                if (reason === 'Parcel Not delivered') {
                                    document.getElementById('parcelNotDeliveredModal').style.display = 'flex';
                                }

                                this.style.borderColor = '#e5e5e5';
                                document.getElementById('reasonErrorMsg').style.display = 'none';
                            });

                            let refundImageDT = new DataTransfer();
                            let refundVideoDT = new DataTransfer();

                            function handleRefundImageUpload(input) {
                                for (let i = 0; i < input.files.length; i++) {
                                    if (refundImageDT.items.length >= 5) break;
                                    refundImageDT.items.add(input.files[i]);
                                }
                                if (refundImageDT.items.length > 5) {
                                    alert('You can only upload a maximum of 5 images.');
                                    const trimmed = new DataTransfer();
                                    for (let i = 0; i < 5; i++) trimmed.items.add(refundImageDT.files[i]);
                                    refundImageDT = trimmed;
                                }
                                input.files = refundImageDT.files;
                                renderRefundImagePreviews();
                            }

                            function renderRefundImagePreviews() {
                                const container = document.getElementById('refundImagePreview');
                                const countEl = document.getElementById('refundImageCount');
                                const addBox = document.getElementById('refundAddPhotoBox');
                                container.innerHTML = '';
                                const count = refundImageDT.files.length;
                                countEl.innerText = '(' + count + '/5)';

                                for (let i = 0; i < count; i++) {
                                    const file = refundImageDT.files[i];
                                    const wrapper = document.createElement('div');
                                    wrapper.style.cssText = 'position:relative; width:72px; height:72px;';

                                    const img = document.createElement('img');
                                    img.src = URL.createObjectURL(file);
                                    img.style.cssText = 'width:72px; height:72px; object-fit:cover; border-radius:2px; border:1px solid #ddd;';
                                    img.title = file.name;
                                    wrapper.appendChild(img);

                                    const xBtn = document.createElement('div');
                                    xBtn.innerHTML = '\u00d7';
                                    xBtn.style.cssText = 'position:absolute; top:-6px; right:-6px; width:18px; height:18px; background:#333; color:#fff; border-radius:50%; font-size:13px; line-height:18px; text-align:center; cursor:pointer;';
                                    xBtn.setAttribute('data-index', i);
                                    xBtn.onclick = function(e) {
                                        e.stopPropagation();
                                        removeRefundImageAtIndex(parseInt(this.getAttribute('data-index')));
                                    };
                                    wrapper.appendChild(xBtn);
                                    container.appendChild(wrapper);
                                }

                                addBox.style.display = count >= 5 ? 'none' : 'flex';
                            }

                            function removeRefundImageAtIndex(idx) {
                                const newDT = new DataTransfer();
                                for (let i = 0; i < refundImageDT.files.length; i++) {
                                    if (i !== idx) newDT.items.add(refundImageDT.files[i]);
                                }
                                refundImageDT = newDT;
                                document.getElementById('imageUpload').files = refundImageDT.files;
                                renderRefundImagePreviews();
                            }

                            function handleRefundVideoUpload(input) {
                                if (input.files.length > 0) {
                                    refundVideoDT = new DataTransfer();
                                    refundVideoDT.items.add(input.files[0]);
                                    input.files = refundVideoDT.files;
                                }
                                renderRefundVideoPreviews();
                            }

                            function renderRefundVideoPreviews() {
                                const container = document.getElementById('refundVideoPreview');
                                const countEl = document.getElementById('refundVideoCount');
                                const addBox = document.getElementById('refundAddVideoBox');
                                container.innerHTML = '';
                                const count = refundVideoDT.files.length;
                                countEl.innerText = '(' + count + '/1)';

                                if (count > 0) {
                                    const file = refundVideoDT.files[0];
                                    const wrapper = document.createElement('div');
                                    wrapper.style.cssText = 'position:relative; width:72px; height:72px;';

                                    const video = document.createElement('video');
                                    video.src = URL.createObjectURL(file);
                                    video.style.cssText = 'width:72px; height:72px; object-fit:cover; border-radius:2px; border:1px solid #ddd;';
                                    video.muted = true;
                                    video.title = file.name;
                                    video.addEventListener('loadeddata', function() {
                                        this.currentTime = 1;
                                    });
                                    wrapper.appendChild(video);

                                    const playIcon = document.createElement('div');
                                    playIcon.innerHTML = '\u25b6';
                                    playIcon.style.cssText = 'position:absolute; bottom:4px; left:4px; color:#fff; font-size:12px; text-shadow:0 0 3px rgba(0,0,0,0.7); pointer-events:none;';
                                    wrapper.appendChild(playIcon);

                                    const xBtn = document.createElement('div');
                                    xBtn.innerHTML = '\u00d7';
                                    xBtn.style.cssText = 'position:absolute; top:-6px; right:-6px; width:18px; height:18px; background:#333; color:#fff; border-radius:50%; font-size:13px; line-height:18px; text-align:center; cursor:pointer;';
                                    xBtn.onclick = function(e) {
                                        e.stopPropagation();
                                        refundVideoDT = new DataTransfer();
                                        document.getElementById('videoUpload').value = '';
                                        renderRefundVideoPreviews();
                                    };
                                    wrapper.appendChild(xBtn);
                                    container.appendChild(wrapper);
                                    addBox.style.display = 'none';
                                } else {
                                    addBox.style.display = 'flex';
                                }
                            }
                        </script>
                    </div>
                </div>
            </div>

            <!-- Section: Return Method -->
            <div class="section-box">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <h3 class="section-title" style="margin-bottom: 0;">Return Method</h3>
                    <button type="button" class="btn-action secondary" style="padding: 6px 12px; min-width: auto;" onclick="document.getElementById('changeReturnMethodModal').style.display='flex'">Change</button>
                </div>
                
                <div style="margin-top: 15px;">
                    <div id="display-return-method" style="font-weight: 500; font-size: 16px; margin-bottom: 5px;">Drop-Off</div>
                    <div id="display-return-desc" style="color: #666; font-size: 14px;">Drop off your parcel at the nearest courier branch.</div>
                </div>

                <input type="hidden" name="returnMethod" id="input-return-method" value="Drop-Off" />
                <input type="hidden" name="pickupAddressId" id="input-pickup-address" value="" />

                <!-- Dynamic Address Box (Only shown if Pickup is selected) -->
                <div id="pickup-address-section" style="display: none; margin-top: 20px; padding: 15px; border: 1px solid #eee; border-radius: 4px; background: #fafafa;">
                    <div id="pickup-address-header-btn" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                        <span style="font-weight: 500; color: #333;">Pickup Address</span>
                        @if (ViewBag.AvailableAddresses != null && ((IEnumerable<FYP.Models.Entities.Address>)ViewBag.AvailableAddresses).Any())
                        {
                            <button type="button" onclick="document.getElementById('change-address-modal').style.display='flex'" style="color: #0056b3; font-weight: bold; background: none; border: none; cursor: pointer; padding: 0;">Change</button>
                        }
                        else
                        {
                            <button type="button" onclick="openAddAddressModal()" style="color: #ee4d2d; font-weight: bold; background: none; border: none; cursor: pointer; padding: 0;">+ Add New Address</button>
                        }
                    </div>
                    
                    <div id="selected-address-display" style="font-size: 14px; color: #555;">
                        @if (ViewBag.AvailableAddresses != null && ((IEnumerable<FYP.Models.Entities.Address>)ViewBag.AvailableAddresses).Any())
                        {
                            var defaultAddr = ((IEnumerable<FYP.Models.Entities.Address>)ViewBag.AvailableAddresses).FirstOrDefault(a => a.IsDefault) ?? ((IEnumerable<FYP.Models.Entities.Address>)ViewBag.AvailableAddresses).First();
                            <div style="font-weight: 500; color: #333; margin-bottom: 4px;">@defaultAddr.FullName | @defaultAddr.PhoneNumber</div>
                            <div>@defaultAddr.HouseBuildingStreet, @defaultAddr.UnitNumber, <br/> @defaultAddr.StateArea, @defaultAddr.PostalCode</div>
                            <script>
                                document.addEventListener('DOMContentLoaded', function() {
                                    document.getElementById('input-pickup-address').value = '@defaultAddr.AddressID';
                                });
                            </script>
                        }
                        else
                        {
                            <span style="color: #d0011b;">No address found. Please add an address.</span>
                        }
                    </div>
                </div>
            </div>

            <!-- Section 4: Solution -->
            <div class="section-box" style="display: flex; align-items: center;">
                <h3 class="section-title" style="margin-bottom: 0; width: 200px;">Solution:</h3>
                <span style="font-weight: 500;">Return and Refund</span>
            </div>

            <!-- Section 5: Refund Details -->
            <div class="section-box">
                <h3 class="section-title">Refund Details</h3>
                
                <div class="form-group" style="margin-bottom: 16px; display: flex; align-items: center;">
                    <span style="color: #666; width: 200px;">Refund Amount:</span>
                    <span style="font-size: 18px; font-weight: 500;">RM @Model.TotalAmount.ToString("0.00")</span>
                </div>

                <div class="form-group" style="margin-bottom: 24px; display: flex; align-items: center;">
                    <span style="color: #666; width: 200px;">Refund To:</span>
                    <span style="font-weight: 500;">Original Payment Method</span>
                </div>

                <div class="form-group" style="display: flex; align-items: flex-start; margin-top: 24px;">
                    <div style="width: 200px; display: flex; align-items: center; padding-top: 10px;">
                        <span style="color: #d0011b; margin-right: 4px;">*</span>
                        <label class="form-label" style="margin-bottom: 0;">Email:</label>
                    </div>
                    <div style="flex: 1; max-width: 400px; position: relative;">
                        <input type="email" name="refundEmail" id="refundEmailInput" class="form-control" value="@(Model.Buyer?.Email ?? "")" placeholder="example@email.com" style="width: 100%;" required />
                        <div id="emailErrorMsg" style="position: absolute; left: 0; top: 100%; margin-top: 4px; color: #d0011b; font-size: 12px; display: none;">Please fill in a valid email.</div>
                    </div>
                </div>

                <div class="footer-action" style="flex-direction: column; align-items: flex-end; gap: 20px; margin-top: 40px; padding-top: 24px; border-top: 1px solid #eee;">
                    <div style="display: flex; align-items: center; justify-content: flex-end; gap: 40px;">
                        <span style="color: #666; font-size: 15px;">Actual Refund Amount</span>
                        <span style="font-size: 24px; font-weight: 500; color: #ee4d2d;">RM @Model.TotalAmount.ToString("0.00")</span>
                    </div>
                    <button type="submit" class="btn-action primary" style="padding: 12px 30px; font-size: 16px; width: 160px; text-align: center;">Submit</button>
                </div>
            </div>
        </form>

    </main>

    <!-- Issue Type Modal (Change) -->
    <div id="changeIssueModal" class="modal">
        <div class="modal-content" style="max-width: 600px; text-align: left; padding: 24px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
                <h2 style="margin: 0; font-size: 22px; font-weight: 500; color: #222;">What happened to your order?</h2>
                <span class="close-modal" onclick="document.getElementById('changeIssueModal').style.display='none'" style="font-size: 28px; cursor: pointer; color: #666;">&times;</span>
            </div>
            
            <div style="display: flex; flex-direction: column; gap: 16px;">
                <!-- Option 1 -->
                <div onclick="window.location.href='/Buyer/RequestRefundForm?orderId=@Model.OrderID&issueType=Received Items with Issues'" style="display: flex; align-items: center; padding: 20px; background-color: #f8f8f8; border: 1px solid #eaeaea; border-radius: 4px; cursor: pointer; transition: all 0.2s ease;">
                    <div style="margin-right: 20px; color: #ee4d2d;">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><polyline points="11 3 11 11 14 13 14 21"></polyline></svg>
                    </div>
                    <div>
                        <div style="font-size: 18px; color: #222; margin-bottom: 4px;">Received Items with Issues</div>
                        <div style="font-size: 14px; color: #888;">Received all items but there are problems and/or I would like to return parcel</div>
                    </div>
                </div>

                <!-- Option 2 -->
                <div onclick="window.location.href='/Buyer/RequestRefundForm?orderId=@Model.OrderID&issueType=Did Not Receive Some/All of the Item(s)'" style="display: flex; align-items: center; padding: 20px; background-color: #f8f8f8; border: 1px solid #eaeaea; border-radius: 4px; cursor: pointer; transition: all 0.2s ease;">
                    <div style="margin-right: 20px; color: #ee4d2d;">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                    </div>
                    <div>
                        <div style="font-size: 18px; color: #222; margin-bottom: 4px;">Did Not Receive Some/All of the Item(s)</div>
                        <div style="font-size: 14px; color: #888;">Some/all of my item(s) or accessories are not delivered</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Return Method Modal -->
    <div id="changeReturnMethodModal" class="modal">
        <div class="modal-content" style="max-width: 500px; text-align: left; padding: 24px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
                <h2 style="margin: 0; font-size: 20px; font-weight: 500; color: #222;">Select Return Method</h2>
                <span class="close-modal" onclick="document.getElementById('changeReturnMethodModal').style.display='none'" style="font-size: 28px; cursor: pointer; color: #666;">&times;</span>
            </div>
            
            <div style="display: flex; flex-direction: column; gap: 16px;">
                <label style="display: flex; align-items: flex-start; padding: 15px; border: 1px solid var(--brand-primary); border-radius: 4px; cursor: pointer;" id="lbl-dropoff">
                    <input type="radio" name="modal_return_method" value="Drop-Off" checked style="margin-top: 4px; margin-right: 15px; accent-color: var(--brand-primary); width: 16px; height: 16px;" onclick="selectReturnMethod(this, 'Drop-Off', 'Drop off your parcel at the nearest courier branch.')" />
                    <div>
                        <div style="font-size: 16px; font-weight: 500; color: #222; margin-bottom: 4px;">Drop-Off</div>
                        <div style="font-size: 14px; color: #888;">Drop off your parcel at the nearest courier branch.</div>
                    </div>
                </label>

                <label style="display: flex; align-items: flex-start; padding: 15px; border: 1px solid #ddd; border-radius: 4px; cursor: pointer;" id="lbl-pickup">
                    <input type="radio" name="modal_return_method" value="Pickup" style="margin-top: 4px; margin-right: 15px; accent-color: var(--brand-primary); width: 16px; height: 16px;" onclick="selectReturnMethod(this, 'Pickup', 'Courier will pick up the parcel from your address.')" />
                    <div>
                        <div style="font-size: 16px; font-weight: 500; color: #222; margin-bottom: 4px;">Pickup</div>
                        <div style="font-size: 14px; color: #888;">Courier will pick up the parcel from your address.</div>
                    </div>
                </label>
            </div>
            <div style="text-align: right; margin-top: 24px;">
                <button type="button" onclick="confirmReturnMethod()" class="btn-action primary" style="padding: 10px 20px;">Confirm</button>
            </div>
        </div>
    </div>

    <!-- Change Address Modal -->
    <div id="change-address-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 10000; justify-content: center; align-items: center;">
        <div style="background: #fff; width: 550px; max-width: 90%; border-radius: 8px; box-shadow: 0 5px 15px rgba(0,0,0,0.3); padding: 0; display: flex; flex-direction: column;">
            <div style="padding: 20px; border-bottom: 1px solid #eee; display: flex; justify-content: space-between; align-items: center;">
                <h3 style="margin: 0; color: #333; font-size: 1.2rem;">Select Address</h3>
                <button type="button" onclick="document.getElementById('change-address-modal').style.display='none'" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: #999;">&times;</button>
            </div>
            <div id="address-list-container" style="padding: 20px; overflow-y: auto; max-height: 400px; display: flex; flex-direction: column; gap: 15px;">
                @if(ViewBag.AvailableAddresses != null)
                {
                    foreach (var addr in (IEnumerable<FYP.Models.Entities.Address>)ViewBag.AvailableAddresses)
                    {
                        var isChecked = addr.IsDefault ? "checked" : "";
                        var addrString = $"{addr.HouseBuildingStreet}, {addr.StateArea} {addr.PostalCode}";
                        <label style="display: flex; align-items: flex-start; justify-content: space-between; padding: 15px; border: 1px solid #ddd; border-radius: 4px; cursor: pointer;" class="address-option-lbl">
                            <div style="display: flex; align-items: flex-start;">
                                <input type="radio" name="modal_address_selection" value="@addr.AddressID" data-fullname="@addr.FullName" data-phone="@addr.PhoneNumber" data-details="@addr.HouseBuildingStreet, @addr.UnitNumber, <br/> @addr.StateArea, @addr.PostalCode" @isChecked style="margin-top: 4px; margin-right: 15px; accent-color: var(--brand-primary); width: 16px; height: 16px;" onclick="selectAddressRadio(this)" />
                                <div>
                                    <div style="font-weight: bold; margin-bottom: 5px; display: flex; align-items: center; gap: 10px;">
                                        @addr.FullName | @addr.PhoneNumber
                                        @if(addr.IsDefault) {
                                            <span style="border: 1px solid var(--brand-primary); color: var(--brand-primary); font-size: 0.75rem; padding: 2px 6px; border-radius: 3px;">Default</span>
                                        }
                                    </div>
                                    <div style="color: #666; font-size: 0.95rem;">
                                        @addr.HouseBuildingStreet, @addr.UnitNumber, <br/>
                                        @addr.StateArea, @addr.PostalCode
                                    </div>
                                </div>
                            </div>
                            <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 8px;">
                                <a href="javascript:void(0)" onclick="document.getElementById('change-address-modal').style.display='none'; openEditAddressModal('@addr.AddressID', '@addr.FullName.Replace("'", "\\'")', '@addr.PhoneNumber', '@addr.StateArea.Replace("'", "\\'")', '@addr.PostalCode', '@(addr.UnitNumber?.Replace("'", "\\'") ?? "")', '@addr.HouseBuildingStreet.Replace("'", "\\'")', '@addr.Label', @addr.IsDefault.ToString().ToLower(), '@addr.Latitude', '@addr.Longitude')" style="color: #0056b3; font-weight: bold; text-decoration: none; font-size: 0.9rem;">Edit</a>
                                <a href="javascript:void(0)" onclick="deleteAddressAJAX('@addr.AddressID', this)" style="color: #ee4d2d; font-weight: bold; text-decoration: none; font-size: 0.9rem;">Delete</a>
                            </div>
                        </label>
                    }
                }
            </div>
            <div style="padding: 20px; border-top: 1px solid #eee; display: flex; justify-content: space-between; align-items: center;">
                <button type="button" onclick="document.getElementById('change-address-modal').style.display='none'; openAddAddressModal()" style="display: inline-flex; align-items: center; gap: 5px; color: #555; background: none; font-weight: bold; border: 1px solid #ccc; padding: 8px 15px; border-radius: 4px; font-size: 0.9rem; cursor: pointer;">
                    <span style="font-size: 1.2rem;">+</span> Add New Address
                </button>
                <button type="button" id="confirm-address-btn" onclick="confirmAddressSelection()" class="btn btn-primary" style="background: var(--brand-primary); color: white; padding: 10px 20px; border: none; border-radius: 4px; font-weight: bold; cursor: pointer;">Confirm</button>
            </div>
        </div>
    </div>

    <script>
        let tempReturnMethod = 'Drop-Off';
        let tempReturnDesc = 'Drop off your parcel at the nearest courier branch.';

        function validateRefundForm() {
            const reasonSelect = document.getElementById('reasonSelect');
            if (!reasonSelect.value) {
                reasonSelect.style.borderColor = '#ee4d2d';
                document.getElementById('reasonErrorMsg').style.display = 'block';
                return false;
            }

            confirmReturnMethod(); // Ensure any unconfirmed selection is applied before submit
            if (reasonSelect.value !== 'Parcel Not delivered' && refundImageDT.files.length === 0 && refundVideoDT.files.length === 0) {
                alert("Please upload at least one image or video as proof.");
                return false;
            }
            if (document.getElementById('input-return-method').value === 'Pickup' && !document.getElementById('input-pickup-address').value) {
                alert("Please select a pickup address.");
                return false;
            }
            return true;
        }

        function selectReturnMethod(radio, method, desc) {
            document.getElementById('lbl-dropoff').style.borderColor = '#ddd';
            document.getElementById('lbl-pickup').style.borderColor = '#ddd';
            radio.closest('label').style.borderColor = 'var(--brand-primary)';
            tempReturnMethod = method;
            tempReturnDesc = desc;
        }

        function confirmReturnMethod() {
            document.getElementById('display-return-method').textContent = tempReturnMethod;
            document.getElementById('display-return-desc').textContent = tempReturnDesc;
            document.getElementById('input-return-method').value = tempReturnMethod;
            
            if (tempReturnMethod === 'Pickup') {
                document.getElementById('pickup-address-section').style.display = 'block';
            } else {
                document.getElementById('pickup-address-section').style.display = 'none';
            }
            
            document.getElementById('changeReturnMethodModal').style.display = 'none';
        }

        function selectAddressRadio(radio) {
            document.querySelectorAll('input[name="modal_address_selection"]').forEach(r => {
                r.closest('.address-option-lbl').style.borderColor = '#ddd';
            });
            radio.closest('.address-option-lbl').style.borderColor = 'var(--brand-primary)';
        }

        function confirmAddressSelection() {
            const selectedRadio = document.querySelector('input[name="modal_address_selection"]:checked');
            if (selectedRadio) {
                document.getElementById('input-pickup-address').value = selectedRadio.value;
                const fullname = selectedRadio.getAttribute('data-fullname');
                const phone = selectedRadio.getAttribute('data-phone');
                const details = selectedRadio.getAttribute('data-details');
                
                document.getElementById('selected-address-display').innerHTML = `
                    <div style="font-weight: 500; color: #333; margin-bottom: 4px;">${fullname} | ${phone}</div>
                    <div>${details}</div>
                `;
            }
            document.getElementById('change-address-modal').style.display = 'none';
        }

        function deleteAddressAJAX(id, element) {
            if (!confirm('Are you sure you want to delete this address?')) return;
            
            const formData = new FormData();
            formData.append('id', id);
            
            fetch('/Buyer/DeleteAddress', {
                method: 'POST',
                body: formData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data && data.success) {
                    element.closest('.address-option-lbl').remove();
                } else {
                    alert('Error deleting address.');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error deleting address.');
            });
        }
        
        // Email Validation Logic
        const emailInput = document.getElementById('refundEmailInput');
        const emailError = document.getElementById('emailErrorMsg');
        
        emailInput.addEventListener('input', function() {
            if (this.value.trim() === '' || !this.validity.valid) {
                emailError.style.display = 'block';
            } else {
                emailError.style.display = 'none';
            }
        });
        
        // Disable native tooltip
        emailInput.addEventListener('invalid', function(e) {
            e.preventDefault();
            emailError.style.display = 'block';
        });

        document.addEventListener('addressSaved', function(e) {
            window.addressSavedHandled = true;
            const newAddr = e.detail;
            
            const addrId = newAddr.addressID || newAddr.AddressID;
            const fullname = newAddr.fullName || newAddr.FullName;
            const phone = newAddr.phoneNumber || newAddr.PhoneNumber;
            const street = newAddr.houseBuildingStreet || newAddr.HouseBuildingStreet;
            const state = newAddr.stateArea || newAddr.StateArea;
            const postal = newAddr.postalCode || newAddr.PostalCode;
            const unitObj = newAddr.unitNumber || newAddr.UnitNumber;
            const unit = unitObj ? unitObj + ', <br/> ' : '';
            
            document.getElementById('input-pickup-address').value = addrId;
            
            document.getElementById('selected-address-display').innerHTML = `
                <div style="font-weight: 500; color: #333; margin-bottom: 4px;">${fullname} | ${phone}</div>
                <div>${street}, ${unit}${state}, ${postal}</div>
            `;
            
            document.getElementById('pickup-address-header-btn').innerHTML = `
                <span style="font-weight: 500; color: #333;">Pickup Address</span>
                <button type="button" onclick="document.getElementById('change-address-modal').style.display='flex'" style="color: #0056b3; font-weight: bold; background: none; border: none; cursor: pointer; padding: 0;">Change</button>
            `;
        });
    </script>
    @await Html.PartialAsync("_ChatPartial")
    @await Html.PartialAsync("_AddressModalPartial")

    <div id="parcelNotDeliveredModal" class="modal" style="display:none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.5); align-items: center; justify-content: center;">
        <div style="background: white; padding: 30px; border-radius: 8px; max-width: 400px; text-align: center;">
            <h3 style="margin-top: 0; color: #333;">Check Proof of Delivery</h3>
            <p style="color: #666; margin-bottom: 10px;">Tracking Number: <strong>@(delivery?.TrackingNumber ?? "N/A")</strong></p>
            <p style="color: #666; margin-bottom: 20px;">Delivered on <strong>@(delivery?.ActualDeliveryDate?.ToString("dd MMM yyyy, HH:mm") ?? "N/A")</strong></p>
            <p style="color: #333; margin-bottom: 25px; font-weight: 500;">Please check your whatsapp for driver's delivery proof.</p>
            <div style="display: flex; gap: 10px; justify-content: center;">
                <button type="button" onclick="cancelParcelModal()" class="btn-action secondary" style="flex: 1;">Cancel</button>
                <button type="button" onclick="document.getElementById('parcelNotDeliveredModal').style.display='none'" class="btn-action primary" style="flex: 1;">Continue</button>
            </div>
        </div>
    </div>
    <script>
        function cancelParcelModal() {
            document.getElementById('parcelNotDeliveredModal').style.display = 'none';
            document.getElementById('reasonSelect').value = '';
            document.getElementById('proofInstructionsList').innerHTML = '<li>Content of the parcel received</li><li>Packaging from all angles</li>';
        }
    </script>
</body>
</html>
