@model FYP.Models.ViewModels.HelpCategoryViewModel
@{
    ViewData["Title"] = Model.Category.Name + " - Help Center";
    Layout = "~/Views/Shared/_HelpLayout.cshtml";
}

<link rel="stylesheet" href="~/css/help-center.css" />

<div class="help-container" style="padding-top: 30px;">

    <!-- Breadcrumb -->
    <div class="help-breadcrumb">
        <a asp-controller="Help" asp-action="Index">Help Center</a>
        <span class="separator">&rsaquo;</span>
        <span class="current">@Model.Category.Name</span>
    </div>

    <!-- Category Header -->
    <div class="help-category-page-header">
        <div class="icon">
            @if (Model.Category.IconClass == "shield-lock")
            {
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><rect x="9" y="10" width="6" height="5" rx="1"></rect><path d="M12 10V7"></path></svg>
            }
            else if (Model.Category.IconClass == "credit-card")
            {
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
            }
            else if (Model.Category.IconClass == "truck")
            {
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
            }
            else if (Model.Category.IconClass == "arrow-return-left")
            {
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 14 4 9 9 4"></polyline><path d="M20 20v-7a4 4 0 0 0-4-4H4"></path></svg>
            }
            else if (Model.Category.IconClass == "file-text")
            {
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
            }
        </div>
        <div>
            <h1>@Model.Category.Name</h1>
            <p>@Model.Articles.Count article(s) in this category</p>
        </div>
    </div>

    <!-- Articles List -->
    @if (Model.Articles.Any())
    {
        <div style="background: white; border: 1px solid #e8e8e8; border-radius: 12px; overflow: hidden;">
            <ul class="help-article-list">
                @foreach (var article in Model.Articles)
                {
                    <li>
                        <a asp-controller="Help" asp-action="Article" asp-route-id="@article.HelpArticleID">
                            <span class="article-icon">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                            </span>
                            @article.Title
                            @if (article.IsPopular)
                            {
                                <span style="background: #EE4D2D; color: white; font-size: 0.65rem; font-weight: 700; padding: 2px 6px; border-radius: 8px; margin-left: 10px; text-transform: uppercase;">POPULAR</span>
                            }
                            <span class="arrow">&rsaquo;</span>
                        </a>
                    </li>
                }
            </ul>
        </div>
    }
    else
    {
        <div style="text-align: center; padding: 60px 20px; color: #888;">
            <p style="font-size: 1.1rem;">No articles in this category yet.</p>
            <a asp-controller="Help" asp-action="Index" style="color: #EE4D2D; text-decoration: none; font-weight: 600;">&larr; Back to Help Center</a>
        </div>
    }

    <!-- Back Link -->
    <div style="margin-top: 30px;">
        <a asp-controller="Help" asp-action="Index" style="color: #EE4D2D; text-decoration: none; font-weight: 500;">&larr; Back to Help Center</a>
    </div>
</div>
