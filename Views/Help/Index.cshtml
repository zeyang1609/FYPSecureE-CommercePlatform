@model FYP.Models.ViewModels.HelpCenterIndexViewModel
@{
    ViewData["Title"] = "Help Center";
    Layout = "~/Views/Shared/_HelpLayout.cshtml";
}

<link rel="stylesheet" href="~/css/help-center.css" />

<!-- Hero Search Section -->
<div class="help-hero">
    <h1>How can we help you today?</h1>
    <p>Search our knowledge base or browse categories below</p>
    <form asp-controller="Help" asp-action="Search" method="get" class="help-search-form">
        <input type="text" name="query" placeholder="Search for answers... e.g. 'refund', 'track order', 'payment'" autocomplete="off" />
        <button type="submit">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            Search
        </button>
    </form>
</div>

<div class="help-container">

    <!-- Browse Categories Section -->
    <div class="help-section-title">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#EE4D2D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
        Browse by Category
    </div>

    <div class="help-categories-grid">
        @foreach (var cat in Model.Categories)
        {
            <a asp-controller="Help" asp-action="Category" asp-route-id="@cat.HelpCategoryID" class="help-category-card">
                <div class="help-category-icon">
                    @if (cat.IconClass == "shield-lock")
                    {
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><rect x="9" y="10" width="6" height="5" rx="1"></rect><path d="M12 10V7"></path></svg>
                    }
                    else if (cat.IconClass == "credit-card")
                    {
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
                    }
                    else if (cat.IconClass == "truck")
                    {
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                    }
                    else if (cat.IconClass == "arrow-return-left")
                    {
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 14 4 9 9 4"></polyline><path d="M20 20v-7a4 4 0 0 0-4-4H4"></path></svg>
                    }
                    else if (cat.IconClass == "file-text")
                    {
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                    }
                </div>
                <div class="help-category-info">
                    <h3>@cat.Name</h3>
                    <p>Browse articles</p>
                </div>
            </a>
        }
    </div>

    <!-- Hot Questions Section -->
    @if (Model.PopularArticles.Any())
    {
        <div class="help-section-title">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#EE4D2D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
            Popular Questions
        </div>

        <ul class="help-popular-list">
            @foreach (var article in Model.PopularArticles)
            {
                <li>
                    <a asp-controller="Help" asp-action="Article" asp-route-id="@article.HelpArticleID">
                        <span class="popular-badge">POPULAR</span>
                        @article.Title
                        <span class="arrow">&rsaquo;</span>
                    </a>
                </li>
            }
        </ul>
    }

    <!-- Contact Support Section -->
    <div class="help-contact-section">
        <h2>Still need help?</h2>
        <p>Our support team is ready to assist you with any questions or concerns.</p>
        <div class="help-contact-actions">
            <a href="mailto:support@secureplatform.com" class="help-contact-btn secondary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                Email Support
            </a>
        </div>
    </div>
</div>
