@model FYP.Models.ViewModels.CheckoutViewModel
@{
    ViewData["Title"] = "AI Fraud Protected Checkout";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SecurePlatform</title>
    <link rel="stylesheet" href="~/css/auth-login.css" />
    <link rel="stylesheet" href="~/css/seller-dashboard.css" />
    <link rel="stylesheet" href="~/css/buyer-dashboard.css" />
</head>
<body style="background-color: #F8F9FA;">

    <header class="auth-navbar">
        <div class="nav-container">
            <div style="display: flex; align-items: center;">
                <a asp-controller="Home" asp-action="Index" class="brand-group">
                    <svg viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z" /></svg>
                    <span class="brand-text">SecurePlatform</span>
                </a>
                <span class="page-label">XGBoost Checkout</span>
            </div>
            <div>
                <a asp-controller="Cart" asp-action="Index" class="help-link" style="font-weight: 600;">← Back to Cart</a>
            </div>
        </div>
    </header>

    <main class="buyer-container">

        <div class="buyer-header">
            <div>
                <h1>Secure Payment & Shipping</h1>
                <p>Complete your delivery details. Your session telemetry is currently being analyzed for fraud risk.</p>
            </div>
            <span class="qr-pill" style="font-size: 0.9rem; padding: 8px 14px;">🧠 XGBoost Model Active</span>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div style="background: #FFF0F0; color: #D63031; padding: 15px; border-radius: 6px; border: 1px solid #FFCDCD; margin-bottom: 20px; font-size: 0.9rem; font-weight: bold;">
                @Html.ValidationSummary(false, "", new { @style = "margin: 0; padding-left: 15px;" })
            </div>
        }

        <form asp-controller="Cart" asp-action="ProcessCheckout" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="BuyerID" />
            <input type="hidden" asp-for="TotalAmount" />

            <div style="display: grid; grid-template-columns: 1.5fr 1fr; gap: 30px; align-items: start;">

                <!-- Left Column: Shipping & Payment Details -->
                <div class="table-card" style="margin-bottom: 0; padding: 30px;">
                    <h2 style="font-size: 1.2rem; color: var(--text-dark); margin-bottom: 20px; border-bottom: 2px solid var(--auth-bg-tint); padding-bottom: 10px;">
                        1. Shipping Destination
                    </h2>

                    <div class="form-group" style="margin-bottom: 25px;">
                        <label asp-for="ShippingAddress" class="field-label">Full Delivery Address:</label>
                        <div class="input-wrapper">
                            <input asp-for="ShippingAddress" class="mvc-input" placeholder="e.g., 123 Jalan Ampang, Kuala Lumpur, 50450" required autofocus />
                        </div>
                        <span asp-validation-for="ShippingAddress" class="field-validation-error"></span>
                    </div>

                    <h2 style="font-size: 1.2rem; color: var(--text-dark); margin-bottom: 20px; border-bottom: 2px solid var(--auth-bg-tint); padding-bottom: 10px;">
                        2. Payment Gateway
                    </h2>

                    <div class="form-group" style="margin-bottom: 20px;">
                        <label asp-for="PaymentMethod" class="field-label">Select Payment Method:</label>
                        <div class="input-wrapper">
                            <select asp-for="PaymentMethod" class="mvc-input" style="background: white; cursor: pointer;">
                                <option value="Credit Card">Credit Card (Argon2id Encrypted Vault)</option>
                                <option value="FPX Online Banking">FPX Online Banking</option>
                                <option value="DuitNow QR">DuitNow Instant QR</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group" style="margin-bottom: 10px;">
                        <label asp-for="CardNumber" class="field-label">Card Number (16 Digits):</label>
                        <div class="input-wrapper">
                            <input asp-for="CardNumber" class="mvc-input" placeholder="4532 •••• •••• 8890" maxlength="16" required />
                        </div>
                        <span asp-validation-for="CardNumber" class="field-validation-error"></span>
                    </div>
                </div>

                <!-- Right Column: Telemetry Summary & Submit -->
                <div style="display: flex; flex-direction: column; gap: 20px;">

                    <div class="table-card" style="margin-bottom: 0; padding: 25px;">
                        <h3 style="font-size: 1.1rem; color: var(--text-dark); margin-bottom: 15px; border-bottom: 1px solid var(--border-color); padding-bottom: 10px;">
                            Order Breakdown (@Model.CartItems.Sum(i => i.Quantity) items)
                        </h3>

                        <div style="max-height: 180px; overflow-y: auto; margin-bottom: 15px;">
                            @foreach (var item in Model.CartItems)
                            {
                                <div style="display: flex; justify-content: space-between; font-size: 0.85rem; margin-bottom: 8px; color: #555;">
                                    <span>@item.Quantity x @item.Title</span>
                                    <strong>RM @item.Subtotal.ToString("0.00")</strong>
                                </div>
                            }
                        </div>

                        <div style="display: flex; justify-content: space-between; border-top: 2px solid var(--auth-bg-tint); padding-top: 15px; font-size: 1.3rem; font-weight: bold; color: var(--text-dark);">
                            <span>Total Due:</span>
                            <span style="color: var(--brand-primary);">RM @Model.TotalAmount.ToString("0.00")</span>
                        </div>

                        <button type="submit" class="btn-submit-primary" style="width: 100%; padding: 15px; font-size: 1rem; margin-top: 25px;">
                            AUTHORIZE & PAY RM @Model.TotalAmount.ToString("0.00") →
                        </button>

                        <div style="margin-top: 15px; padding: 12px; background: #FFF5F3; border-radius: 4px; font-size: 0.75rem; color: #D63031; line-height: 1.4;">
                            <strong>🧠 XGBoost Algorithmic Telemetry:</strong>
                            • Velocity & expenditure anomalies evaluated in real-time.<br />
                            • Orders exceeding RM 5,000.00 trigger step-up MFA verification.
                        </div>
                    </div>

                </div>

            </div>
        </form>
    </main>
</body>
</html>