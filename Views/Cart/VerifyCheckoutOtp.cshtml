@{
    ViewData["Title"] = "Security Check - Verification Required";
}

<div class="container mt-5 mb-5" style="max-width: 600px; margin: 0 auto;">
    <div class="card shadow-sm border-0" style="border-radius: 12px; overflow: hidden;">
        <div class="card-header bg-warning text-dark text-center py-4" style="border-bottom: 3px solid #ff9800;">
            <i class="fas fa-shield-alt fa-3x mb-2"></i>
            <h4 class="mb-0 fw-bold">Security Verification Required</h4>
        </div>
        <div class="card-body p-5 bg-white">
            <p class="text-center text-muted mb-4">
                Our AI Security Shield has flagged this transaction as medium-risk due to abnormal behavior. 
                Please enter the OTP sent to your email to authorize this transaction and finalize checkout.
            </p>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger" role="alert" style="border-radius: 8px;">
                    <i class="fas fa-exclamation-circle me-2"></i> @Html.ValidationSummary(false, "", new { @class = "mb-0" })
                </div>
            }

            <form asp-action="VerifyCheckoutOtp" asp-controller="Cart" method="post">
                @Html.AntiForgeryToken()
                <div class="form-group mb-4">
                    <label for="otp" class="form-label fw-bold">One-Time Password (OTP)</label>
                    <input type="text" id="otp" name="otp" class="form-control form-control-lg text-center" 
                           placeholder="Enter 6-digit OTP" required style="letter-spacing: 2px; font-size: 1.5rem;" />
                </div>
                <div class="d-grid gap-2">
                    <button type="submit" id="btnVerify" class="btn btn-warning btn-lg fw-bold" style="background-color: #ff9800; border: none;">
                        Verify & Complete Checkout <i class="fas fa-arrow-right ms-2"></i>
                    </button>
                    <button type="button" id="btnResend" class="btn btn-outline-primary mt-2">
                        Resend Verification Code
                    </button>
                    <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-secondary mt-2">
                        Cancel Checkout
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const btnResend = document.getElementById("btnResend");
        let resendTimer = null;

        const storageKey = 'otpCheckoutTimer';
        @if (TempData["ResetOtpTimer"] != null)
        {
            <text>
            localStorage.removeItem(storageKey);
            </text>
        }

        function startResendTimer() {
            let now = Math.floor(Date.now() / 1000);
            let sentTime = localStorage.getItem(storageKey);
            
            if (!sentTime) {
                sentTime = now;
                localStorage.setItem(storageKey, sentTime);
            }
            
            let elapsed = now - parseInt(sentTime);
            let timeLeft = 60 - elapsed;
            
            if (timeLeft <= 0) {
                btnResend.disabled = false;
                btnResend.textContent = "Resend Verification Code";
                return;
            }

            btnResend.disabled = true;
            btnResend.textContent = `Resend (${timeLeft}s)`;
            
            resendTimer = setInterval(() => {
                timeLeft--;
                
                if (timeLeft <= 0) {
                    clearInterval(resendTimer);
                    btnResend.disabled = false;
                    btnResend.textContent = "Resend Verification Code";
                } else {
                    btnResend.textContent = `Resend (${timeLeft}s)`;
                }
            }, 1000);
        }

        if (btnResend) {
            startResendTimer();
            
            btnResend.addEventListener("click", async function(e) {
                e.preventDefault();
                if (this.disabled) return;
                
                this.disabled = true;
                this.textContent = "Sending...";

                try {
                    const response = await fetch('@Url.Action("ResendCheckoutOtp", "Cart")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                        }
                    });

                    if (response.ok) {
                        alert("A new 6-digit security code has been dispatched to your email address.");
                        localStorage.setItem(storageKey, Math.floor(Date.now() / 1000));
                        if (resendTimer) clearInterval(resendTimer);
                        startResendTimer();
                    } else {
                        alert("Failed to resend code. Please try again.");
                        this.disabled = false;
                        this.textContent = "Resend Verification Code";
                    }
                } catch (error) {
                    console.error(error);
                    alert("An error occurred while resending the code.");
                    this.disabled = false;
                    this.textContent = "Resend Verification Code";
                }
            });
        }
    });
</script>
