@model IEnumerable<FYP.Models.Entities.Category>
@{
    ViewData["Title"] = "Manage Categories - AdminOS";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SecurePlatform</title>
    <link rel="stylesheet" href="~/css/auth-login.css" />
    <link rel="stylesheet" href="~/css/seller-dashboard.css" />
    <link rel="stylesheet" href="~/css/admin-dashboard-sidebar-v2.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        .form-control:focus { outline: none; border-color: #EE4D2D !important; box-shadow: 0 0 0 2px rgba(238,77,45,0.2) !important; }
        button[type="submit"]:hover { background: #d73a1b !important; }
    </style>
</head>
<body style="background-color: #F8F9FA;">

    @await Html.PartialAsync("_AdminNavigationBar")

    <main class="dashboard-container" style="max-width: 1400px;">
        <div class="dashboard-header" style="border-left: 4px solid #EE4D2D;">
            <div>
                <h1>Catalog Category Management</h1>
                <p>Add and manage product categories for the storefront.</p>
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div style="padding: 15px; background: #d4edda; color: #155724; border-radius: 5px; margin-bottom: 20px; border-left: 4px solid #28a745;">
                @TempData["SuccessMessage"]
            </div>
        }

        <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 30px; margin-top: 20px;">
            <!-- Add Category Form -->
            <div class="table-card" style="height: fit-content; margin-bottom: 0;">
                <div class="table-header" style="margin-bottom: 20px;">
                    <h2>➕ Add New Category</h2>
                </div>
                <form asp-controller="Admin" asp-action="CreateCategory" method="post" enctype="multipart/form-data">
                    <div style="margin-bottom: 15px;">
                        <label style="font-weight: bold; display: block; margin-bottom: 5px; color: #495057;">Category Name</label>
                        <input type="text" name="name" required class="form-control" style="width: 100%; padding: 10px; box-sizing: border-box; border: 1px solid #ced4da; border-radius: 4px;" placeholder="e.g., Cyber Security Hardware" />
                    </div>

                    <div style="margin-bottom: 15px;">
                        <label style="font-weight: bold; display: block; margin-bottom: 5px; color: #495057;">Description</label>
                        <textarea name="description" rows="3" style="width: 100%; padding: 10px; box-sizing: border-box; border: 1px solid #ced4da; border-radius: 4px;" placeholder="Brief description of products in this category..."></textarea>
                    </div>

                    <div style="margin-bottom: 20px;">
                        <label style="font-weight: bold; display: block; margin-bottom: 5px; color: #495057;">Icon (Image File)</label>
                        <input type="file" name="iconFile" accept="image/*" class="form-control" style="width: 100%; padding: 10px; box-sizing: border-box; border: 1px solid #ced4da; border-radius: 4px;" />
                        <small style="color: #6c757d;">Leave blank to use default icon</small>
                    </div>

                    <button type="submit" style="background: #EE4D2D; color: white; border: none; padding: 12px 20px; border-radius: 4px; cursor: pointer; font-weight: bold; width: 100%; transition: background 0.2s;">Create Category</button>
                </form>
            </div>

            <!-- Existing Categories List -->
            <div class="table-card" style="margin-bottom: 0;">
                <div class="table-header">
                    <h2>📁 Active Storefront Categories (@Model.Count())</h2>
                </div>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Icon</th>
                            <th>Name & Description</th>
                            <th>Active Products</th>
                            <th>Category ID</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cat in Model)
                        {
                            <tr>
                                <td style="width: 50px; text-align: center;">
                                    <div style="width: 32px; height: 32px; color: #333; margin: auto;">
                                        @if (!string.IsNullOrEmpty(cat.IconSvg) && cat.IconSvg.TrimStart().StartsWith("<svg"))
                                        {
                                            @Html.Raw(cat.IconSvg)
                                        }
                                        else if (!string.IsNullOrEmpty(cat.IconSvg))
                                        {
                                            <img src="@cat.IconSvg" width="32" height="32" style="object-fit: cover; border-radius: 4px;" />
                                        }
                                    </div>
                                </td>
                                <td>
                                    <strong style="font-size: 1.05rem;">@cat.Name</strong><br />
                                    <small style="color: #6c757d;">@cat.Description</small>
                                </td>
                                <td>
                                    <span style="background: #e9ecef; padding: 6px 12px; border-radius: 20px; font-weight: bold; font-size: 0.85rem;">
                                        @cat.Products.Count items
                                    </span>
                                </td>
                                <td style="font-family: monospace; font-size: 0.85rem; color: #6c757d;">
                                    @cat.CategoryID
                                </td>
                                <td>
                                    @if (cat.Name == "Undefined")
                                    {
                                        <span style="color: #6c757d; font-style: italic; font-size: 0.85rem;">System Category</span>
                                    }
                                    else
                                    {
                                        <div style="display: flex; gap: 10px;">
                                            <a href="@Url.Action("EditCategory", "Admin", new { id = cat.CategoryID })" style="background: #ffc107; color: #212529; text-decoration: none; padding: 6px 12px; border-radius: 4px; font-weight: bold; font-size: 0.85rem;">Edit</a>
                                            <form asp-controller="Admin" asp-action="DeleteCategory" method="post" onsubmit="return confirm('Are you sure you want to delete this category? Any associated products will be reassigned to the Undefined category.');" style="margin: 0;">
                                                <input type="hidden" name="id" value="@cat.CategoryID" />
                                                <button type="submit" style="background: #dc3545; color: white; border: none; padding: 6px 12px; border-radius: 4px; cursor: pointer; font-weight: bold; font-size: 0.85rem;">Delete</button>
                                            </form>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </main>

</body>
</html>

@await Html.PartialAsync("_ChatPartial")
