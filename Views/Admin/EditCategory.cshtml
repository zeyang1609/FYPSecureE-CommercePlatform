@model FYP.Models.Entities.Category
@{
    ViewData["Title"] = "Edit Category - AdminOS";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SecurePlatform</title>
    <link rel="stylesheet" href="~/css/auth-login.css" />
    <link rel="stylesheet" href="~/css/seller-dashboard.css" />
    <link rel="stylesheet" href="~/css/admin-dashboard-sidebar-v2.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        .form-control:focus { outline: none; border-color: #EE4D2D !important; box-shadow: 0 0 0 2px rgba(238,77,45,0.2) !important; }
        button[type="submit"]:hover { background: #d73a1b !important; }
    </style>
</head>
<body style="background-color: #F8F9FA;">

    @await Html.PartialAsync("_AdminNavigationBar")

    <main class="dashboard-container" style="max-width: 800px; margin: 0 auto; margin-top: 40px;">
        <div class="dashboard-header" style="border-left: 4px solid #EE4D2D;">
            <div>
                <h1>Edit Category</h1>
                <p>Modify details for category: <strong>@Model.Name</strong></p>
            </div>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div style="padding: 15px; background: #f8d7da; color: #721c24; border-radius: 5px; margin-bottom: 20px; border-left: 4px solid #dc3545;">
                @TempData["ErrorMessage"]
            </div>
        }

        <div class="table-card" style="padding: 30px;">
            <form asp-controller="Admin" asp-action="EditCategory" method="post" enctype="multipart/form-data">
                <input type="hidden" name="id" value="@Model.CategoryID" />
                
                <div style="margin-bottom: 15px;">
                    <label style="font-weight: bold; display: block; margin-bottom: 5px; color: #495057;">Category ID</label>
                    <input type="text" value="@Model.CategoryID" disabled class="form-control" style="width: 100%; padding: 10px; box-sizing: border-box; border: 1px solid #ced4da; border-radius: 4px; background-color: #e9ecef;" />
                </div>

                <div style="margin-bottom: 15px;">
                    <label style="font-weight: bold; display: block; margin-bottom: 5px; color: #495057;">Category Name</label>
                    <input type="text" name="name" required class="form-control" value="@Model.Name" style="width: 100%; padding: 10px; box-sizing: border-box; border: 1px solid #ced4da; border-radius: 4px;" />
                </div>

                <div style="margin-bottom: 15px;">
                    <label style="font-weight: bold; display: block; margin-bottom: 5px; color: #495057;">Description</label>
                    <textarea name="description" rows="4" style="width: 100%; padding: 10px; box-sizing: border-box; border: 1px solid #ced4da; border-radius: 4px;">@Model.Description</textarea>
                </div>

                <div style="margin-bottom: 25px;">
                    <label style="font-weight: bold; display: block; margin-bottom: 10px; color: #495057;">Current Icon</label>
                    <div style="display: flex; align-items: center; gap: 15px; background: #f8f9fa; padding: 15px; border: 1px solid #dee2e6; border-radius: 8px;">
                        <div style="width: 48px; height: 48px; color: #333;">
                            @if (!string.IsNullOrEmpty(Model.IconSvg) && Model.IconSvg.TrimStart().StartsWith("<svg"))
                            {
                                @Html.Raw(Model.IconSvg)
                            }
                            else if (!string.IsNullOrEmpty(Model.IconSvg))
                            {
                                <img src="@Model.IconSvg" width="48" height="48" style="object-fit: cover; border-radius: 4px;" />
                            }
                        </div>
                        <div style="flex-grow: 1;">
                            <label style="font-weight: bold; display: block; margin-bottom: 5px; color: #495057; font-size: 0.9rem;">Upload New Icon (Image File)</label>
                            <input type="file" name="iconFile" accept="image/*" class="form-control" style="width: 100%; padding: 8px; box-sizing: border-box; border: 1px solid #ced4da; border-radius: 4px; font-size: 0.9rem;" />
                            <small style="color: #6c757d; display: block; margin-top: 5px;">Leave blank to keep the current icon.</small>
                        </div>
                    </div>
                </div>

                <div style="display: flex; gap: 15px;">
                    <button type="submit" style="flex: 2; background: #EE4D2D; color: white; border: none; padding: 12px 20px; border-radius: 4px; cursor: pointer; font-weight: bold; transition: background 0.2s;">
                        Save Changes
                    </button>
                    <a asp-controller="Admin" asp-action="Categories" style="flex: 1; background: #6c757d; color: white; text-align: center; text-decoration: none; border: none; padding: 12px 20px; border-radius: 4px; cursor: pointer; font-weight: bold; transition: background 0.2s;">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </main>
</body>
</html>

@await Html.PartialAsync("_ChatPartial")
