@model IEnumerable<FYP.Models.Entities.AuditLog>
@{
    ViewData["Title"] = "AdminOS - Audit Logs";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/auth-login.css" />
    <link rel="stylesheet" href="~/css/seller-dashboard.css" />
    <link rel="stylesheet" href="~/css/admin-dashboard-sidebar-v2.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        /* ── Filter Card ── */
        .audit-filter-card {
            background: #fff;
            border-radius: 10px;
            box-shadow: 0 1px 4px rgba(0,0,0,0.06);
            padding: 24px 28px;
            margin-bottom: 24px;
        }
        .audit-filter-card .filter-title {
            font-size: 0.82rem;
            font-weight: 600;
            color: #868E96;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .audit-filter-card .filter-title::before {
            content: '';
            display: inline-block;
            width: 4px;
            height: 16px;
            background: #EE4D2D;
            border-radius: 2px;
        }
        .filter-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            align-items: end;
        }
        .filter-group label {
            display: block;
            font-size: 0.78rem;
            font-weight: 600;
            color: #495057;
            margin-bottom: 6px;
            letter-spacing: 0.3px;
        }
        .filter-group input {
            width: 100%;
            padding: 9px 14px;
            border: 1.5px solid #E9ECEF;
            border-radius: 8px;
            font-size: 0.88rem;
            color: #343A40;
            background: #FAFBFC;
            transition: all 0.2s ease;
            outline: none;
            box-sizing: border-box;
        }
        .filter-group input:focus {
            border-color: #EE4D2D;
            background: #fff;
            box-shadow: 0 0 0 3px rgba(238, 77, 45, 0.08);
        }
        .filter-group input::placeholder {
            color: #ADB5BD;
        }
        .filter-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 18px;
            padding-top: 16px;
            border-top: 1px solid #F1F3F5;
        }
        .btn-filter-clear {
            padding: 9px 24px;
            border: 1.5px solid #DEE2E6;
            background: #fff;
            color: #495057;
            font-size: 0.88rem;
            font-weight: 500;
            border-radius: 8px;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.2s ease;
        }
        .btn-filter-clear:hover {
            background: #F8F9FA;
            border-color: #CED4DA;
            color: #343A40;
        }
        .btn-filter-apply {
            padding: 9px 28px;
            border: none;
            background: linear-gradient(135deg, #EE4D2D, #E8421F);
            color: #fff;
            font-size: 0.88rem;
            font-weight: 600;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.25s ease;
            box-shadow: 0 2px 8px rgba(238, 77, 45, 0.25);
        }
        .btn-filter-apply:hover {
            background: linear-gradient(135deg, #D74022, #C4361A);
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(238, 77, 45, 0.35);
        }

        /* ── Table ── */
        .audit-table-card {
            background: #fff;
            border-radius: 10px;
            box-shadow: 0 1px 4px rgba(0,0,0,0.06);
            overflow: hidden;
        }
        .audit-table {
            width: 100%;
            border-collapse: collapse;
        }
        .audit-table thead {
            background: linear-gradient(135deg, #F8F9FA, #F1F3F5);
        }
        .audit-table thead th {
            padding: 14px 20px;
            font-size: 0.78rem;
            font-weight: 700;
            color: #6C757D;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            border: none;
            border-bottom: 2px solid #E9ECEF;
            white-space: nowrap;
        }
        .audit-table thead th a {
            color: #6C757D;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: color 0.2s;
        }
        .audit-table thead th a:hover {
            color: #EE4D2D;
        }
        .sort-icon {
            font-size: 0.7rem;
            opacity: 0.5;
        }
        .audit-table tbody tr {
            border-bottom: 1px solid #F1F3F5;
            transition: background 0.15s ease;
        }
        .audit-table tbody tr:hover {
            background: #FFF8F6;
        }
        .audit-table tbody tr:last-child {
            border-bottom: none;
        }
        .audit-table tbody td {
            padding: 16px 20px;
            vertical-align: middle;
            font-size: 0.9rem;
        }
        .timestamp-cell {
            color: #868E96;
            font-size: 0.85rem;
            white-space: nowrap;
            font-variant-numeric: tabular-nums;
        }
        .user-cell {
            font-weight: 600;
            color: #212529;
        }
        .action-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.82rem;
            font-weight: 500;
            line-height: 1.4;
        }
        .action-badge.danger {
            background: #FFEAEA;
            color: #C92A2A;
        }
        .action-badge.success {
            background: #E6F9EC;
            color: #1B7F37;
        }
        .action-badge.neutral {
            background: #F1F3F5;
            color: #495057;
        }
        .ip-cell {
            color: #868E96;
            font-family: 'Courier New', monospace;
            font-size: 0.83rem;
        }
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: #868E96;
        }
        .empty-state .empty-icon {
            font-size: 3rem;
            margin-bottom: 12px;
            opacity: 0.4;
        }
        .empty-state .empty-text {
            font-size: 1rem;
            font-weight: 500;
        }
        .empty-state .empty-sub {
            font-size: 0.85rem;
            color: #ADB5BD;
            margin-top: 4px;
        }

        @@media (max-width: 768px) {
            .filter-grid {
                grid-template-columns: 1fr 1fr;
            }
        }
        @@media (max-width: 480px) {
            .filter-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body style="background-color: #F8F9FA;">

    @await Html.PartialAsync("_AdminNavigationBar")

    <main class="dashboard-container" style="max-width: 1200px;">
        <div class="dashboard-header" style="border-left: 4px solid #EE4D2D; margin-bottom: 24px;">
            <div>
                <h2 style="margin: 0 0 4px 0;">System Audit Logs</h2>
                <p style="margin: 0; color: #868E96; font-size: 0.92rem;">Monitor and track user activities and system events.</p>
            </div>
        </div>

        <!-- Filter Card -->
        <div class="audit-filter-card">
            <div class="filter-title">Filters</div>
            <form asp-action="AuditLogs" method="get">
                <div class="filter-grid">
                    <div class="filter-group">
                        <label>Start Date</label>
                        <input type="date" name="startDate" id="startDate" value="@ViewData["StartDateFilter"]" max="@DateTime.Now.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="filter-group">
                        <label>End Date</label>
                        <input type="date" name="endDate" id="endDate" value="@ViewData["EndDateFilter"]" max="@DateTime.Now.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="filter-group">
                        <label>User Name / Email</label>
                        <input type="text" name="nameFilter" value="@ViewData["NameFilter"]" placeholder="Search user..." />
                    </div>
                    <div class="filter-group">
                        <label>Action</label>
                        <input type="text" name="actionFilter" value="@ViewData["ActionFilter"]" placeholder="e.g. Login Failed" />
                    </div>
                </div>
                <div class="filter-actions">
                    <a asp-action="AuditLogs" class="btn-filter-clear">Clear</a>
                    <button type="submit" class="btn-filter-apply">Apply Filters</button>
                </div>
            </form>
        </div>

        <!-- Table Card -->
        <div class="audit-table-card">
            <table class="audit-table">
                <thead>
                    <tr>
                        <th>
                            <a asp-action="AuditLogs" asp-route-sortOrder="@ViewData["DateSortParm"]"
                               asp-route-startDate="@ViewData["StartDateFilter"]"
                               asp-route-endDate="@ViewData["EndDateFilter"]"
                               asp-route-nameFilter="@ViewData["NameFilter"]"
                               asp-route-actionFilter="@ViewData["ActionFilter"]">
                                Timestamp <span class="sort-icon">↕</span>
                            </a>
                        </th>
                        <th>
                            <a asp-action="AuditLogs" asp-route-sortOrder="@ViewData["UserSortParm"]"
                               asp-route-startDate="@ViewData["StartDateFilter"]"
                               asp-route-endDate="@ViewData["EndDateFilter"]"
                               asp-route-nameFilter="@ViewData["NameFilter"]"
                               asp-route-actionFilter="@ViewData["ActionFilter"]">
                                User <span class="sort-icon">↕</span>
                            </a>
                        </th>
                        <th>Action</th>
                        <th>IP Address</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var log in Model)
                        {
                            <tr>
                                <td class="timestamp-cell">
                                    @log.Timestamp.ToString("MMM dd, yyyy HH:mm:ss")
                                </td>
                                <td class="user-cell">
                                    @(log.User?.Name ?? log.User?.Email ?? log.UserID ?? "System / Unknown")
                                </td>
                                <td>
                                    @if (log.Action.Contains("Failed") || log.Action.Contains("Error") || log.Action.Contains("Blocked"))
                                    {
                                        <span class="action-badge danger">@log.Action</span>
                                    }
                                    else if (log.Action.Contains("Added") || log.Action.Contains("Created") || log.Action.Contains("Success") || log.Action.Contains("successfully") || log.Action.Contains("Completed"))
                                    {
                                        <span class="action-badge success">@log.Action</span>
                                    }
                                    else
                                    {
                                        <span class="action-badge neutral">@log.Action</span>
                                    }
                                </td>
                                <td class="ip-cell">@log.IP_Address</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4">
                                <div class="empty-state">
                                    <div class="empty-icon">📋</div>
                                    <div class="empty-text">No audit logs found</div>
                                    <div class="empty-sub">Try adjusting your filters to see more results.</div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const startDateInput = document.getElementById('startDate');
            const endDateInput = document.getElementById('endDate');
            const today = new Date().toISOString().split('T')[0];

            startDateInput.addEventListener('change', function () {
                if (startDateInput.value) {
                    endDateInput.min = startDateInput.value;
                } else {
                    endDateInput.min = "";
                }
            });

            endDateInput.addEventListener('change', function () {
                if (endDateInput.value) {
                    startDateInput.max = endDateInput.value;
                } else {
                    startDateInput.max = today;
                }
            });
            
            if (startDateInput.value) {
                endDateInput.min = startDateInput.value;
            }
            if (endDateInput.value) {
                startDateInput.max = endDateInput.value;
            }
        });
    </script>
</body>
</html>

@await Html.PartialAsync("_ChatPartial")
