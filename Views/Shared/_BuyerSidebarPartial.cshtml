@using System.Security.Claims
@{
    var userId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    var userName = User.Identity?.Name ?? "User";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}

<div class="profile-sidebar">
    <div class="user-brief">
        <div class="avatar-circle" style="background: transparent; overflow: hidden; border: 1px solid #e0e0e0; display: flex; align-items: center; justify-content: center; position: relative;">
            <img src="/uploads/profiles/@(userId).jpg?v=@(DateTime.Now.Ticks)" 
                 style="width: 100%; height: 100%; object-fit: cover; display: block;" 
                 onerror="this.style.display='none'; document.getElementById('sidebar-default-avatar').style.display='block';" />
            <svg id="sidebar-default-avatar" style="display: none; width: 24px; height: 24px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
            </svg>
        </div>
        <div class="user-brief-info">
            <div class="username-text">@userName</div>
            <a href="/Buyer/Profile" class="edit-profile-link">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 20h9"></path>
                    <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                </svg> Edit Profile
            </a>
        </div>
    </div>
    <nav class="profile-nav">
        <div class="nav-group active">
            <div class="nav-group-header">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                <span>My Account</span>
            </div>
            <ul class="nav-list">
                <li><a href="/Buyer/Profile" class="@(currentAction == "Profile" ? "active" : "")">Profile</a></li>
                <li><a href="/Buyer/BanksAndCards" class="@(currentAction == "BanksAndCards" ? "active" : "")">Banks & Cards</a></li>
                <li><a href="/Buyer/Addresses" class="@(currentAction == "Addresses" ? "active" : "")">Addresses</a></li>
                <li><a href="/Buyer/ChangePasswordVerify" class="@(currentAction.StartsWith("ChangePassword") ? "active" : "")">Change Password</a></li>
                <li><a href="/Buyer/TrustedDevices" class="@(currentAction == "TrustedDevices" ? "active" : "")">Trusted Devices</a></li>
            </ul>
        </div>
        <div class="nav-group">
            <a href="/Buyer/Orders" class="nav-group-link @(currentAction == "Orders" ? "active" : "")">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                <span>My Purchase</span>
            </a>
        </div>
        <div class="nav-group">
            <a href="#" class="nav-group-link">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
                <span>Notifications</span>
            </a>
        </div>
    </nav>
</div>
