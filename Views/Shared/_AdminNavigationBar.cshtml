@{
    var _context = Context.RequestServices.GetService(typeof(FYP.Data.ApplicationDbContext)) as FYP.Data.ApplicationDbContext;
    var unreadAdminNotifications = 0;
    var adminId = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    if (adminId != null && _context != null) { unreadAdminNotifications = _context.Notifications.Count(n => n.UserID == adminId && !n.IsRead); }
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}

<aside class="admin-navbar">
    <div style="display: flex; align-items: center; margin-bottom: 30px;">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="#EE4D2D" style="margin-right: 12px;">
            <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z" />
        </svg>
        <span style="color: white; font-weight: 700; font-size: 1.4rem; letter-spacing: 0.5px;">ADMIN<span style="color: #EE4D2D;">OS</span></span>
    </div>
    <div class="admin-nav-links">
        <div class="nav-section">Main Menu</div>
        <a asp-action="Dashboard" class="@(currentAction == "Dashboard" ? "active" : "")">🛡️ Security Dashboard</a>
        <a asp-action="Analytics" class="@(currentAction == "Analytics" ? "active" : "")">📊 Platform Analytics</a>
        <a asp-action="ManageOrders" class="@(currentAction == "ManageOrders" ? "active" : "")">📦 Manage Orders</a>
        <a asp-action="Users" class="@(currentAction == "Users" ? "active" : "")">👥 User Management</a>
        <a asp-action="Categories" class="@(currentAction == "Categories" ? "active" : "")">📁 Categories</a>
        <a asp-action="Disputes" class="@(currentAction == "Disputes" ? "active" : "")">⚖️ Disputes</a>
        
        <div class="nav-section" style="margin-top: 20px;">System Configuration</div>
        <a asp-action="TrustedDevices" class="@(currentAction == "TrustedDevices" ? "active" : "")">📱 Trusted Devices</a>
        <a asp-action="Announcements" class="@(currentAction == "Announcements" ? "active" : "")">📢 Announcements</a>
        <a asp-action="ManageImageBlacklist" class="@(currentAction == "ManageImageBlacklist" ? "active" : "")">🚫 Image Blacklist</a>
        <a asp-action="ManageUrlBlacklist" class="@(currentAction == "ManageUrlBlacklist" ? "active" : "")">🔗 URL Blacklist</a>
        <a asp-action="ManageIpFilters" class="@(currentAction == "ManageIpFilters" ? "active" : "")">🌐 IP Filtering</a>
        <a asp-action="AuditLogs" class="@(currentAction == "AuditLogs" ? "active" : "")">📋 Audit Logs</a>
        
        <div class="nav-section" style="margin-top: 20px;">Account</div>
        <a asp-controller="Auth" asp-action="SetupTotp" class="@(currentAction == "SetupTotp" ? "active" : "")">🔐 2FA Setup</a>
        <a asp-action="Notifications" class="@(currentAction == "Notifications" ? "active" : "")" style="position: relative; display: flex; align-items: center; justify-content: space-between;">
            <span>🔔 Notifications</span>
            @if (unreadAdminNotifications > 0)
            {
                <span style="background-color: #ef4444; color: white; font-size: 0.75rem; padding: 2px 8px; border-radius: 10px; font-weight: bold;">@unreadAdminNotifications</span>
            }
        </a>
        <a asp-controller="Auth" asp-action="Logout" asp-route-returnUrl="/Admin/Login" style="color: #ef4444;">🚪 Log Out</a>
    </div>
</aside>
