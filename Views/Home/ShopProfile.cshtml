@model FYP.Models.ViewModels.ShopProfileViewModel
@{
    ViewData["Title"] = Model.Seller.Name + "'s Shop";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SecurePlatform</title>
    <link rel="stylesheet" href="~/css/platform-home.css" />
    <link rel="stylesheet" href="~/css/seller-shop.css" />
</head>
<body style="display: flex; flex-direction: column; min-height: 100vh;">

    <!-- Hidden field for JS to read the seller ID -->
    <input type="hidden" id="shopSellerId" value="@Model.Seller.UserID" />

    <!-- ===== Main Navigation Header (reuses platform-home.css) ===== -->
    <header class="main-header">
        <div class="header-top">
            <div class="top-nav-left">
                <a asp-controller="Seller" asp-action="Login">Seller Centre</a>
            </div>
            <div class="top-nav-right">
                <a href="#" class="nav-icon-link" aria-label="Notifications">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                        <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                    </svg>
                    <span>Notifications</span>
                </a>
                <span class="nav-divider">|</span>
                <a href="#" class="nav-icon-link" aria-label="Help">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                        <line x1="12" y1="17" x2="12.01" y2="17"></line>
                    </svg>
                    <span>Help</span>
                </a>
                <span class="nav-divider">|</span>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="profile-dropdown" style="position: relative; display: inline-block;">
                        <a href="/@User.Claims.FirstOrDefault(c=>c.Type==System.Security.Claims.ClaimTypes.Role)?.Value/Dashboard" class="nav-icon-link" aria-label="Profile">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                            <span>@User.Identity?.Name</span>
                        </a>
                        <div class="dropdown-menu">
                            <a href="/@User.Claims.FirstOrDefault(c=>c.Type==System.Security.Claims.ClaimTypes.Role)?.Value/Profile">My Account</a>
                            <a href="/@User.Claims.FirstOrDefault(c=>c.Type==System.Security.Claims.ClaimTypes.Role)?.Value/Orders">My Purchase</a>
                            <a asp-controller="Auth" asp-action="Logout">Log Out</a>
                        </div>
                    </div>
                }
                else
                {
                    <a asp-controller="Auth" asp-action="Register">Sign Up</a>
                    <span class="nav-divider">|</span>
                    <a asp-controller="Auth" asp-action="Login">Log In</a>
                }
            </div>
        </div>

        <!-- Search bar with scope dropdown -->
        <div class="header-content">
            <a asp-controller="Home" asp-action="Index" class="logo-container">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor" style="min-width: 32px;">
                    <path d="M12 2L4 5v6.09c0 5.05 3.41 9.76 8 10.91 4.59-1.15 8-5.86 8-10.91V5l-8-3zm0 15c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" />
                </svg>
                <span>SecurePlatform</span>
            </a>

            <form asp-controller="Home" asp-action="ShopProfile" asp-route-id="@Model.Seller.UserID" method="get" class="search-container" id="shopSearchForm">
                <!-- Search scope dropdown -->
                <select id="searchScopeSelect" class="search-scope-select">
                    <option value="shop">In This Shop</option>
                    <option value="platform">In SecurePlatform</option>
                </select>
                <input type="text" name="searchQuery" id="shopSearchInput" class="search-input" placeholder="Search in @(string.IsNullOrWhiteSpace(Model.Seller.Name) ? "this shop" : Model.Seller.Name)..." />
                <button type="submit" class="search-btn" aria-label="Search">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                </button>
            </form>

            <a asp-controller="Cart" asp-action="Index" class="cart-link" aria-label="Shopping Cart">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="9" cy="21" r="1"></circle>
                    <circle cx="20" cy="21" r="1"></circle>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                </svg>
            </a>
        </div>
    </header>

    <!-- ===== Shop Header Banner ===== -->
    <div class="shop-header">
        <div class="shop-header-inner">
            <!-- Circular shop logo (first letter of name) -->
            <div class="shop-logo">
                @(string.IsNullOrWhiteSpace(Model.Seller.Name) ? "S" : Model.Seller.Name.Substring(0, 1).ToUpper())
            </div>

            <!-- Shop name and badge -->
            <div class="shop-header-info">
                <div class="shop-header-name">@(Model.Seller.Name ?? Model.Seller.UserID)</div>
                <div class="shop-header-badge">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                    AI Verified Merchant
                </div>
            </div>

            <!-- Stats grid -->
            <div class="shop-header-stats">
                <div class="shop-stat-item">
                    <span class="shop-stat-label">Products:</span>
                    <span class="shop-stat-value">@Model.TotalProducts</span>
                </div>
                <div class="shop-stat-item">
                    <span class="shop-stat-label">Rating:</span>
                    <span class="shop-stat-value">@Model.OverallRating.ToString("0.0")</span>
                </div>
                <div class="shop-stat-item">
                    <span class="shop-stat-label">Response:</span>
                    <span class="shop-stat-value">N/A</span>
                </div>
                <div class="shop-stat-item">
                    <span class="shop-stat-label">Joined:</span>
                    <span class="shop-stat-value">@Model.Seller.CreatedAt.ToString("MMM yyyy")</span>
                </div>
                <div class="shop-stat-item">
                    <span class="shop-stat-label">Total Sales:</span>
                    <span class="shop-stat-value">@Model.TotalSales</span>
                </div>
            </div>

            <!-- Chat with seller button -->
            <div class="shop-header-actions">
                <button class="btn-chat-seller">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                    </svg>
                    Chat Now
                </button>
            </div>
        </div>
    </div>

    <!-- ===== Sticky Navigation Bar ===== -->
    <nav class="shop-nav">
        <div class="shop-nav-inner">
            <button class="shop-nav-tab active" data-tab="home">Home</button>
            <button class="shop-nav-tab" data-tab="all-products">All Products</button>
            @foreach (var cat in Model.SellerCategories)
            {
                <button class="shop-nav-tab" data-tab="home" onclick="document.getElementById('cat-@cat.CategoryID')?.scrollIntoView({behavior:'smooth',block:'start'})">@cat.Name</button>
            }
        </div>
    </nav>

    <!-- ===== Content Area ===== -->
    <main style="flex: 1; width: 100%;">
        <div class="shop-content">

            <!-- ===== HOME TAB ===== -->
            <div id="panel-home" class="shop-tab-panel active">
                @if (Model.CategoryProducts.Any())
                {
                    @foreach (var kvp in Model.CategoryProducts)
                    {
                        var catEntry = Model.SellerCategories.FirstOrDefault(c => c.Name == kvp.Key);
                        <div class="shop-category-section" id="cat-@catEntry?.CategoryID">
                            <div class="shop-category-title">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--brand-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="3" width="7" height="7"></rect>
                                    <rect x="14" y="3" width="7" height="7"></rect>
                                    <rect x="14" y="14" width="7" height="7"></rect>
                                    <rect x="3" y="14" width="7" height="7"></rect>
                                </svg>
                                @kvp.Key
                            </div>
                            <div class="shop-product-row">
                                @foreach (var product in kvp.Value)
                                {
                                    @await Html.PartialAsync("_ShopProductCard", product)
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="shop-no-products">
                        <svg width="64" height="64" viewBox="0 0 24 24" fill="#ddd"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14zm-7-2h2v-2h-2v2zm0-4h2V7h-2v6z"/></svg>
                        <h3>No products in this shop yet</h3>
                        <p>Check back later!</p>
                    </div>
                }
            </div>

            <!-- ===== ALL PRODUCTS TAB ===== -->
            <div id="panel-all-products" class="shop-tab-panel">
                <div class="shop-all-products-layout">

                    <!-- Left: Category Sidebar -->
                    <div class="shop-sidebar">
                        <div class="shop-sidebar-title">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#333" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="3" y1="12" x2="21" y2="12"></line>
                                <line x1="3" y1="6" x2="21" y2="6"></line>
                                <line x1="3" y1="18" x2="21" y2="18"></line>
                            </svg>
                            All Categories
                        </div>
                        <button class="shop-sidebar-item active" data-category-id="">All Products</button>
                        @foreach (var cat in Model.SellerCategories)
                        {
                            <button class="shop-sidebar-item" data-category-id="@cat.CategoryID">@cat.Name</button>
                        }
                    </div>

                    <!-- Right: Sort Bar + Product Grid -->
                    <div class="shop-main-area">
                        <div class="shop-sort-bar">
                            <span class="shop-sort-label">Sort By</span>
                            <button class="shop-sort-btn active" data-sort="popular">Popular</button>
                            <button class="shop-sort-btn" data-sort="latest">Latest</button>
                            <button class="shop-sort-btn" data-sort="topsales">Top Sales</button>
                            <select class="shop-sort-select" id="priceSortSelect">
                                <option value="">Price</option>
                                <option value="price_asc">Low to High</option>
                                <option value="price_desc">High to Low</option>
                            </select>
                        </div>

                        <!-- AJAX-loaded product grid container -->
                        <div id="shopProductGridContainer">
                            <div style="text-align: center; padding: 60px; color: #999;">
                                Click "All Products" to browse.
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </main>

    <footer style="text-align: center; padding: 20px 0; border-top: 1px solid #ddd; background: #fff; margin-top: auto; color: #6c757d; font-size: 0.9rem; width: 100%;">
        <div class="container">
            &copy; 2026 - FYP - <a asp-controller="Home" asp-action="Privacy" style="color: #007bff; text-decoration: none;">Privacy</a>
        </div>
    </footer>

    <script src="~/js/seller-shop.js"></script>
</body>
</html>
