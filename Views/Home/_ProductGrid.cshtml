@model IEnumerable<FYP.Models.Entities.Product>

@if (Model != null && Model.Any())
{
    @foreach (var item in Model)
    {
        <div class="product-card">
            <!-- Dynamically maps to wwwroot/uploads/[ProductID].jpg generated by AI vision scanner -->
            <a asp-controller="Home" asp-action="ProductDetails" asp-route-id="@item.ProductID" style="text-decoration: none; color: inherit; display: flex; flex-direction: column; flex: 1;">
                <img src="~/uploads/@(item.ProductID).jpg" alt="@item.Title" class="product-img" onerror="this.src='/images/default-product.jpg';" />

                <div class="product-info">
                    <div>
                        <div class="product-title">@item.Title</div>
                    </div>

                    <div class="product-footer">
                        <span class="product-price">RM @item.Price.ToString("0.00")</span>
                        <span class="sold-count">@item.TotalSales sold</span>
                    </div>
                </div>
            </a>
        </div>
    }
}
else
{
    <div style="grid-column: 1 / -1; text-align: center; padding: 50px; background: white; border-radius: 6px; border: 1px solid var(--border-color); color: #666;">
        <h3 style="color: #333; margin-bottom: 8px;">No verified products found.</h3>
        <p style="margin-bottom: 20px;">Merchants are currently uploading items through the AI vision verification pipeline.</p>
    </div>
}
