@model FYP.Models.ViewModels.ResetPasswordOtpViewModel
@{
    ViewData["Title"] = "Verify Reset Code";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - E-Commerce Security Portal</title>
    <link rel="stylesheet" href="~/css/auth-login.css" />
</head>
<body>

    <header class="auth-navbar">
        <div class="nav-container">
            <div style="display: flex; align-items: center;">
                <a asp-controller="Home" asp-action="Index" class="brand-group">
                    <svg viewBox="0 0 24 24">
                        <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z" />
                    </svg>
                    <span class="brand-text">SecurePlatform</span>
                </a>
                <span class="page-label">Security Verification</span>
            </div>
            <a href="#" class="help-link">Need Help?</a>
        </div>
    </header>

    <main class="login-main">
        <div class="layout-grid">

            <section class="hero-column">
                <h1 class="hero-title">Identity Verification</h1>
                <p class="hero-subtitle">Enter the 6-digit verification code sent to your inbox to unlock password modification.</p>
                <div class="security-badge">
                    MFA Security Gateway Active
                </div>
            </section>

            <section class="auth-card">
                <div class="card-header">
                    <h2>Enter OTP Code</h2>
                </div>
                <p style="font-size: 13px; color: #666; margin-bottom: 20px; line-height: 1.5;">
                    A verification token was dispatched to <strong>@Model.Email</strong>. Enter it below to proceed.
                </p>

                <form asp-controller="Auth" asp-action="ResetPasswordOtp" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Email" />
                    <div asp-validation-summary="ModelOnly" class="text-danger" style="font-size: 13px; margin-bottom: 10px;"></div>

                    <div class="form-group">
                        <label asp-for="OtpCode" class="field-label">6-Digit Verification Code:</label>
                        <div class="input-wrapper">
                            <input asp-for="OtpCode" class="mvc-input" placeholder="e.g. 123456" maxlength="6" autocomplete="one-time-code" autofocus />
                        </div>
                        <span asp-validation-for="OtpCode" class="text-danger field-validation-error"></span>
                    </div>

                    <button type="submit" id="submit-btn" class="btn-submit-primary" style="margin-top: 15px;">VERIFY & CONTINUE</button>
                </form>

                <div class="auth-footer" style="margin-top: 25px; border-top: 1px solid #eee; padding-top: 15px;">
                    Didn't receive the code? <a href="#" id="resendLink" class="resend-link active" style="color: #EE4D2D; font-weight: 500; text-decoration: none;">Resend Verification Code</a>
                </div>
            </section>

        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const resendLink = document.getElementById("resendLink");
            if (resendLink) {
                let resendTimer = null;
                var storageKey = 'otpResetTimer_' + '@Model.Email';
        @if (TempData["ResetOtpTimer"] != null)
        {
            <text>
            localStorage.removeItem(storageKey);
            </text>
        }

                function startResendTimer() {
                    let now = Math.floor(Date.now() / 1000);
                    let sentTime = localStorage.getItem(storageKey);
                    
                    if (!sentTime) {
                        sentTime = now;
                        localStorage.setItem(storageKey, sentTime);
                    }
                    
                    let elapsed = now - parseInt(sentTime);
                    let timeLeft = 60 - elapsed;
                    
                    if (timeLeft <= 0) {
                        resendLink.classList.add("active");
                        resendLink.style.pointerEvents = "auto";
                        resendLink.style.color = "#EE4D2D";
                        resendLink.textContent = "Resend Verification Code";
                        return;
                    }

                    resendLink.classList.remove("active");
                    resendLink.style.pointerEvents = "none";
                    resendLink.style.color = "#999";
                    resendLink.innerHTML = `Resend Code <span id="timerSpan">(${timeLeft}s)</span>`;
                    
                    resendTimer = setInterval(() => {
                        timeLeft--;
                        if (timeLeft <= 0) {
                            clearInterval(resendTimer);
                            resendLink.classList.add("active");
                            resendLink.style.pointerEvents = "auto";
                            resendLink.style.color = "#EE4D2D";
                            resendLink.textContent = "Resend Verification Code";
                        } else {
                            resendLink.innerHTML = `Resend Code <span id="timerSpan">(${timeLeft}s)</span>`;
                        }
                    }, 1000);
                }
                
                startResendTimer();

                resendLink.addEventListener("click", async function(e) {
                    e.preventDefault();
                    if (!this.classList.contains("active")) return;
                    
                    this.classList.remove("active");
                    this.style.pointerEvents = "none";
                    this.textContent = "Sending...";

                    try {
                        const response = await fetch('@Url.Action("ResendOtp", "Auth")', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                            },
                            body: JSON.stringify({ email: '@Model.Email', purpose: 'Password Reset' })
                        });

                        if (response.ok) {
                            alert("A new 6-digit security code has been dispatched to your email address.");
                            localStorage.setItem(storageKey, Math.floor(Date.now() / 1000));
                            if (resendTimer) clearInterval(resendTimer);
                            startResendTimer();
                        } else {
                            alert("Failed to resend code. Please try again.");
                            this.classList.add("active");
                            this.style.pointerEvents = "auto";
                            this.textContent = "Resend Verification Code";
                        }
                    } catch (error) {
                        console.error(error);
                        alert("An error occurred while resending the code.");
                        this.classList.add("active");
                        this.style.pointerEvents = "auto";
                        this.textContent = "Resend Verification Code";
                    }
                });
            }
        });
    </script>
</body>
</html>
