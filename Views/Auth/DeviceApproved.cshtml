@{
    ViewData["Title"] = "Device Approved";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - E-Commerce Security Portal</title>
    <link rel="stylesheet" href="~/css/auth-login.css" />
    <style>
        .success-icon {
            color: #4CAF50;
            width: 64px;
            height: 64px;
            margin: 0 auto 20px auto;
            display: block;
        }
    </style>
</head>
<body>

    <header class="auth-navbar">
        <div class="nav-container">
            <div style="display: flex; align-items: center;">
                <a asp-controller="Home" asp-action="Index" class="brand-group">
                    <svg viewBox="0 0 24 24">
                        <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z" />
                    </svg>
                    <span class="brand-text">SecurePlatform</span>
                </a>
                <span class="page-label">Authorization Complete</span>
            </div>
        </div>
    </header>

    <main class="login-main">
        <div class="layout-grid" style="grid-template-columns: 1fr; max-width: 600px; margin: 0 auto;">

            <section class="auth-card" style="text-align: center; padding: 50px 30px;">
                <svg class="success-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
                <h2 style="margin-bottom: 20px;">Device Approved</h2>
                <p style="color: #666; font-size: 16px; line-height: 1.5;">
                    You have successfully authorized this device. <br /><br />
                    <strong>Your original browser session has been authenticated. You can safely close this tab now.</strong>
                </p>
            </section>

        </div>
    </main>

</body>
</html>
