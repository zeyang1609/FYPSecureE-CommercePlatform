@model FYP.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Log In";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - E-Commerce Security Portal</title>
    <link rel="stylesheet" href="~/css/auth-login.css" />
</head>
<body>

    <header class="auth-navbar">
        <div class="nav-container">
            <div style="display: flex; align-items: center;">
                <a asp-controller="Home" asp-action="Index" class="brand-group">
                    <svg viewBox="0 0 24 24">
                        <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z" />
                    </svg>
                    <span class="brand-text">SecurePlatform</span>
                </a>
                <span class="page-label">Log In</span>
            </div>
            <a href="#" class="help-link">Need Help?</a>
        </div>
    </header>

    <main class="login-main">
        <div class="layout-grid">

            <section class="hero-column">
                <h1 class="hero-title">AI-Enhanced Secure E-Commerce</h1>
                <p class="hero-subtitle">Smart multi-vendor shopping protected by real-time behavioral analysis and automated zero-trust security.</p>
                <div class="security-badge">
                    AI Fraud Detection Engine Active
                </div>
            </section>

            <section class="auth-card">
                <div class="card-header">
                    <h2>Log In</h2>
                    <a href="#" class="qr-pill">QR Code</a>
                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div style="background-color: #d4edda; color: #155724; padding: 10px; border-radius: 4px; margin-bottom: 15px; font-size: 13px; border: 1px solid #c3e6cb;">
                        @TempData["SuccessMessage"]
                    </div>
                }

                <form asp-controller="Auth" asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Role" value="Buyer" />
                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ContainsKey(string.Empty) && ViewData.ModelState[string.Empty].Errors.Count > 0)
                    {
                        <div id="loginErrorMsg" style="background: #FFF5F5; color: #C53030; padding: 12px; border-radius: 4px; border: 1px solid #FEB2B2; font-size: 13px; margin-bottom: 15px; text-align: center;">
                            @foreach (var error in ViewData.ModelState[string.Empty].Errors)
                            {
                                <div>@error.ErrorMessage</div>
                            }
                        </div>
                    }

                    <div class="form-group">
                        <label asp-for="Email" class="field-label">Email Address:</label>
                        <div class="input-wrapper">
                            <input asp-for="Email" class="mvc-input" placeholder="Enter your registered email" autocomplete="email" autofocus />
                        </div>
                        <span asp-validation-for="Email" class="text-danger field-validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Password" class="field-label">Password:</label>
                        <div class="input-wrapper">
                            <input asp-for="Password" id="loginPassword" type="password" class="mvc-input" placeholder="Password" autocomplete="current-password" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="form-sub-actions">
                        <label class="remember-label">
                            <input asp-for="RememberMe" type="checkbox" />
                            <span>Remember Me</span>
                        </label>
                        <a asp-controller="Auth" asp-action="ForgotPassword" class="text-decoration-none small" style="color: #EE4D2D; font-weight: 600;">Forgot Password?</a>
                    </div>

                    <button type="submit" class="btn-submit-primary">LOG IN</button>
                </form>

                <div class="auth-divider">
                    <span>OR</span>
                </div>

                <div class="social-row" style="margin-bottom: 12px;">
                    <button type="button" class="btn-social">
                        <svg width="18" height="18" viewBox="0 0 24 24"><path fill="#EA4335" d="M12 5c1.6 0 3 .6 4.1 1.7l3.1-3.1C17.3 1.8 14.8 1 12 1 7.4 1 3.5 3.6 1.6 7.4l3.7 2.8C6.2 7.3 8.9 5 12 5z" /><path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.7-.3-2.3H12v4.6h6.5c-.3 1.5-1.1 2.8-2.4 3.7l3.7 2.9c2.2-2 3.7-5 3.7-8.9z" /><path fill="#FBBC05" d="M5.3 14.8c-.2-.8-.4-1.6-.4-2.5s.2-1.7.4-2.5L1.6 7c-.8 1.6-1.3 3.5-1.3 5.5s.5 3.9 1.3 5.5l3.7-2.9z" /><path fill="#34A853" d="M12 23c3.2 0 6-1.1 8-3l-3.7-2.9c-1.1.7-2.5 1.2-4.3 1.2-3.1 0-5.8-2.3-6.7-5.2L1.6 16C3.5 19.8 7.4 22.4 12 23z" /></svg>
                        Log in with Google
                    </button>
                </div>

                <div class="legal-disclaimer">
                    By logging in, you agree to SecurePlatform's
                    <a asp-controller="Home" asp-action="Privacy" class="legal-link" target="_blank">Terms of Service</a> &
                    <a asp-controller="Home" asp-action="Privacy" class="legal-link" target="_blank">Privacy Policy</a>.
                </div>

                <div class="auth-footer">
                    New to SecurePlatform? <a asp-controller="Auth" asp-action="Register">Sign Up</a>
                </div>
            </section>

        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var inputs = document.querySelectorAll('.mvc-input');
            inputs.forEach(function(input) {
                input.addEventListener('input', function() {
                    var errMsg = document.getElementById("loginErrorMsg");
                    if (errMsg) errMsg.style.display = 'none';
                });
            });
        });
        });
    </script>
    <script src="~/js/password-toggle.js"></script>
</body>
</html>