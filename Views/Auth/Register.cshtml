@model FYP.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Sign Up";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - E-Commerce Security Portal</title>
    <link rel="stylesheet" href="~/css/auth-login.css" />
</head>
<body>

    <header class="auth-navbar">
        <div class="nav-container">
            <div style="display: flex; align-items: center;">
                <a asp-controller="Home" asp-action="Index" class="brand-group">
                    <svg viewBox="0 0 24 24">
                        <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z" />
                    </svg>
                    <span class="brand-text">SecurePlatform</span>
                </a>
                <span class="page-label">Sign Up</span>
            </div>
            <a href="#" class="help-link">Need Help?</a>
        </div>
    </header>

    <main class="login-main">
        <div class="layout-grid">

            <section class="hero-column">
                <h1 class="hero-title">Join AI-Enhanced Commerce</h1>
                <p class="hero-subtitle">Create your account today to experience real-time behavioral analysis and automated zero-trust buyer protection.</p>
                <div class="security-badge">
                    Zero-Trust Account Verification
                </div>
            </section>

            <section class="auth-card">
                <div class="card-header">
                    <h2>Sign Up</h2>
                </div>

                <form id="registerForm" asp-controller="Auth" asp-action="Register" method="post" novalidate>

                    <div class="form-group">
                        <label asp-for="Name" class="field-label">Full Name:</label>
                        <div class="input-wrapper" id="nameWrapper">
                            <input asp-for="Name" id="nameInput" class="mvc-input" placeholder="Enter your full name" autocomplete="name" />
                            <div class="status-icon icon-success" id="nameTick">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            </div>
                        </div>
                        <span asp-validation-for="Name" class="text-danger field-validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Email" class="field-label">Email Address:</label>
                        <div class="input-wrapper" id="emailWrapper">
                            <input asp-for="Email" id="emailInput" type="email" class="mvc-input" placeholder="e.g., name@domain.com" autocomplete="email" />
                            <div class="status-icon icon-success" id="emailTick">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            </div>
                        </div>
                        <span id="emailErrorText" class="text-danger field-validation-error" style="display:none;">Please enter a valid email address.</span>
                        <span asp-validation-for="Email" class="text-danger field-validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Password" class="field-label">Password:</label>
                        <div class="input-wrapper" id="passwordWrapper">
                            <input asp-for="Password" id="passwordInput" type="password" class="mvc-input" placeholder="Create a secure password" autocomplete="new-password" />

                            <div class="status-icon icon-success" id="passwordTick" style="right: 38px;">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            </div>
                        </div>

                        <div id="passwordBubble" class="validation-bubble">
                            <strong>Password Requirements:</strong><br />
                            Must be at least 8 characters long, contain no spaces or emojis, and include at least <strong>1 uppercase letter</strong>, <strong>1 lowercase letter</strong>, <strong>1 number</strong>, and <strong>1 special character</strong> (@@$!%*?&^#_.:,+-).
                        </div>
                    </div>



                    <button type="submit" class="btn-submit-primary" style="margin-top: 10px;">SIGN UP</button>
                </form>

                <div class="auth-divider">
                    <span>OR</span>
                </div>

                <div class="social-row" style="margin-bottom: 12px;">
                    <button type="button" class="btn-social">
                        <svg width="18" height="18" viewBox="0 0 24 24"><path fill="#EA4335" d="M12 5c1.6 0 3 .6 4.1 1.7l3.1-3.1C17.3 1.8 14.8 1 12 1 7.4 1 3.5 3.6 1.6 7.4l3.7 2.8C6.2 7.3 8.9 5 12 5z" /><path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.7-.3-2.3H12v4.6h6.5c-.3 1.5-1.1 2.8-2.4 3.7l3.7 2.9c2.2-2 3.7-5 3.7-8.9z" /><path fill="#FBBC05" d="M5.3 14.8c-.2-.8-.4-1.6-.4-2.5s.2-1.7.4-2.5L1.6 7c-.8 1.6-1.3 3.5-1.3 5.5s.5 3.9 1.3 5.5l3.7-2.9z" /><path fill="#34A853" d="M12 23c3.2 0 6-1.1 8-3l-3.7-2.9c-1.1.7-2.5 1.2-4.3 1.2-3.1 0-5.8-2.3-6.7-5.2L1.6 16C3.5 19.8 7.4 22.4 12 23z" /></svg>
                        Log in with Google
                    </button>
                </div>

                <div class="legal-disclaimer">
                    By signing up, you agree to SecurePlatform's
                    <a asp-controller="Home" asp-action="Privacy" class="legal-link" target="_blank">Terms of Service</a> &
                    <a asp-controller="Home" asp-action="Privacy" class="legal-link" target="_blank">Privacy Policy</a>.
                </div>

                <div class="auth-footer">
                    Already have an account? <a asp-controller="Auth" asp-action="Login">Log In</a>
                </div>
            </section>

        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script>
            document.addEventListener("DOMContentLoaded", function() {
                const form = document.getElementById("registerForm");
                const nameInput = document.getElementById("nameInput");
                const nameTick = document.getElementById("nameTick");

                const emailInput = document.getElementById("emailInput");
                const emailTick = document.getElementById("emailTick");
                const emailErrorText = document.getElementById("emailErrorText");

                const passwordInput = document.getElementById("passwordInput");
                const passwordTick = document.getElementById("passwordTick");
                const passwordBubble = document.getElementById("passwordBubble");

                nameInput.addEventListener("input", function() {
                    if (this.value.trim().length >= 2) {
                        this.classList.add("input-success");
                        this.classList.remove("input-error");
                        nameTick.classList.add("visible");
                    } else {
                        this.classList.remove("input-success");
                        nameTick.classList.remove("visible");
                    }
                });

                const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;

                emailInput.addEventListener("input", function() {
                    emailErrorText.style.display = "none";
                    const val = this.value.trim();

                    if (!val) {
                        this.classList.remove("input-success", "input-error");
                        emailTick.classList.remove("visible");
                        return;
                    }

                    if (emailRegex.test(val)) {
                        this.classList.add("input-success");
                        this.classList.remove("input-error");
                        emailTick.classList.add("visible");
                    } else {
                        this.classList.remove("input-success");
                        emailTick.classList.remove("visible");
                    }
                });

                const passwordRegex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@@$!%*?&^#_.:,+-])[a-zA-Z\d@@$!%*?&^#_.:,+-]{8,}$/;

                passwordInput.addEventListener("input", function() {
                    const val = this.value;
                    if (!val) {
                        this.classList.remove("input-success", "input-error");
                        passwordTick.classList.remove("visible");
                        passwordBubble.style.display = "none";
                        return;
                    }

                    if (passwordRegex.test(val)) {
                        this.classList.add("input-success");
                        this.classList.remove("input-error");
                        passwordTick.classList.add("visible");
                        passwordBubble.style.display = "none";
                    } else {
                        this.classList.remove("input-success");
                        this.classList.add("input-error");
                        passwordTick.classList.remove("visible");
                        passwordBubble.style.display = "block";
                    }
                });



                form.addEventListener("submit", function(e) {
                    let isValid = true;

                    if (nameInput.value.trim().length < 2) {
                        nameInput.classList.add("input-error");
                        isValid = false;
                    }

                    if (!emailRegex.test(emailInput.value.trim())) {
                        emailInput.classList.add("input-error");
                        emailErrorText.style.display = "block";
                        isValid = false;
                    }

                    if (!passwordRegex.test(passwordInput.value)) {
                        passwordInput.classList.add("input-error");
                        passwordBubble.style.display = "block";
                        isValid = false;
                    }

                    if (!isValid) {
                        e.preventDefault();
                    }
                });
            });
    </script>
    <script src="~/js/password-toggle.js"></script>
</body>
</html>