@model FYP.Models.ViewModels.SetNewPasswordViewModel
@{
    ViewData["Title"] = "Set New Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - E-Commerce Security Portal</title>
    <link rel="stylesheet" href="~/css/auth-login.css" />
</head>
<body>

    <header class="auth-navbar">
        <div class="nav-container">
            <div style="display: flex; align-items: center;">
                <a asp-controller="Home" asp-action="Index" class="brand-group">
                    <svg viewBox="0 0 24 24">
                        <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z" />
                    </svg>
                    <span class="brand-text">SecurePlatform</span>
                </a>
                <span class="page-label">New Password</span>
            </div>
            <a href="#" class="help-link">Need Help?</a>
        </div>
    </header>

    <main class="login-main">
        <div class="layout-grid">

            <section class="hero-column">
                <h1 class="hero-title">Identity Confirmed</h1>
                <p class="hero-subtitle">Choose a strong new password to protect your account with Argon2id cryptographic security.</p>
                <div class="security-badge">
                    Argon2id Encryption Ready
                </div>
            </section>

            <section class="auth-card">
                <div class="card-header">
                    <h2>New Password</h2>
                </div>
                <p style="font-size: 13px; color: #155724; background-color: #d4edda; padding: 10px; border-radius: 4px; border: 1px solid #c3e6cb; margin-bottom: 15px;">
                    ✓ Identity verified! Choose your new password below.
                </p>

                <form asp-controller="Auth" asp-action="SetNewPassword" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Email" />

                    <div asp-validation-summary="ModelOnly" class="text-danger" style="font-size: 13px; margin-bottom: 10px; font-weight: 600;"></div>

                    <div class="form-group">
                        <label asp-for="NewPassword" class="field-label">New Password:</label>
                        <div class="input-wrapper">
                            <input asp-for="NewPassword" id="new-pw-input" class="mvc-input" type="password" placeholder="At least 8 characters" autofocus />
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger field-validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="ConfirmPassword" class="field-label">Confirm New Password:</label>
                        <div class="input-wrapper">
                            <input asp-for="ConfirmPassword" id="confirm-pw-input" class="mvc-input" type="password" placeholder="Re-type your new password" />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger field-validation-error"></span>
                    </div>

                    <div style="font-size: 11px; color: #666; background-color: #f8f9fa; padding: 10px; border-radius: 4px; border-left: 3px solid #EE4D2D; margin-bottom: 15px; line-height: 1.6;">
                        <strong>Password Requirements:</strong><br />
                        • Minimum 8 characters long (no spaces or emojis)<br />
                        • At least 1 uppercase letter (A-Z) & 1 lowercase letter (a-z)<br />
                        • At least 1 number (0-9) & 1 special character (e.g. @@$!%*?&)
                    </div>

                    <button type="submit" class="btn-submit-primary" style="margin-top: 5px;">UPDATE PASSWORD & LOG IN</button>
                </form>
            </section>

        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script src="~/js/password-toggle.js"></script>
</body>
</html>